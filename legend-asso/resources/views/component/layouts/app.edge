<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" type="image/png" href="/images/favicon.ico" />

    src="/images/icon.png"


    {{-- {{{ await $slots.meta() }}} --}}

    <title>{{ await $slots.title() ? `${await $slots.title()} | Votre Site` : "Page d'accueil | Votre Site" }}</title>

    @vite(['resources/css/app.css', 'resources/js/app.js'])

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&display=swap');
      
      body {
        font-family: 'Epilogue', sans-serif;
        background-color: #F7F7F7;
      }
      
      .sidebar-overlay {
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
      }
      
      .sidebar-overlay.open {
        visibility: visible;
        opacity: 1;
      }
      
      .sidebar-menu {
        transform: translateX(-100%);
        transition: transform 0.3s ease-in-out;
      }
      
      .sidebar-menu.open {
        transform: translateX(0);
      }

      /* Règle de sécurité pour le header si besoin, mais width: 100% est souvent suffisant */
      .full-width-header {
        width: 100%; /* Plus idiomatique que 100vw */
      }
    </style>
  </head>

  <body class="flex flex-col items-center bg-[#F7F7F7]">
    
    {{-- 5. Inclusion du Header (assurez-vous que le header contient le "burger-button" et l'élément "cart-count") --}}
    @include('component/partials/header')

    <main class="w-10/12 mt-28 md:mt-32 flex-grow"> {{-- Ajout de flex-grow pour un footer en bas --}}
      {{{ await $slots.main() }}}
    </main>

    {{-- 5. Inclusion du Footer --}}
    @include('component/partials/footer')

    {{-- 6. MODALE/SIDEBAR MOBILE (Déplacée à la fin pour un chargement plus rapide) --}}
    <div
      id="mobile-sidebar-overlay"
      class="sidebar-overlay fixed inset-0 z-40 bg-white sm:hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sidebar-title"
    >
      <div
        id="mobile-sidebar-menu"
        class="sidebar-menu fixed top-0 left-0 h-full w-64 bg-white shadow-xl flex flex-col z-50"
      >
        <div class="p-4 flex justify-between items-center border-b border-gray-100">
          <img src="/images/icon.png" alt="Icone du site" class="size-8 self-center" />
          <button
            id="sidebar-close-button"
            class="p-2 rounded-lg text-gray-700 hover:bg-gray-100 transition"
            aria-label="Fermer le menu de navigation mobile"
          >
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="flex flex-col p-4 space-y-2 overflow-y-auto flex-grow">
          <a href="{{ route('home') }}" class="sidebar-link active">Accueil</a>
          {{-- <a href="{{ route('catalogue') }}" class="sidebar-link">Catalogue</a> --}}
          <a href="#" class="sidebar-link">Créateurs Locaux</a>
          <a href="#" class="sidebar-link">Blog</a>
          <a href="#" class="sidebar-link">Panier</a>

          <div class="pt-4 border-t mt-4 space-y-2">
            <button class="w-full text-sm py-2 rounded-xl text-white bg-[#CE0000] hover:opacity-80 font-semibold transition">
              Connexion
            </button>
            <button class="w-full text-sm py-2 rounded-xl text-[#171B99] border border-[#171B99] hover:bg-gray-100 transition">
              Créer un compte
            </button>
          </div>
        </nav>
      </div>
    </div>

    {{-- 7. IMPORTATIONS GLOBALES/LOGIQUE (À la fin du body) --}}
    {{-- Axios est maintenant déplacé dans app.js ou importé via CDN après le script modale --}}
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script> 
    
    <script>
      // 8. LOGIQUE MODALE (Sidebar)
      
      const selectors = {
        overlay: "#mobile-sidebar-overlay",
        menu: "#mobile-sidebar-menu",
        closeBtn: "#sidebar-close-button",
        // Assurez-vous d'avoir un ID 'burger-button' dans votre header
        openBtn: "#burger-button", 
      };

      const elements = {
        overlay: document.querySelector(selectors.overlay),
        menu: document.querySelector(selectors.menu),
        closeBtn: document.querySelector(selectors.closeBtn),
        openBtn: document.querySelector(selectors.openBtn),
      };

      /**
       * Gère l'état d'ouverture/fermeture du menu mobile.
       * @param {boolean} open - true pour ouvrir, false pour fermer.
       */
      function toggleSidebar(open) {
        if (!elements.overlay || !elements.menu) return;

        elements.overlay.classList.toggle("open", open);
        elements.menu.classList.toggle("open", open);
        
        document.body.style.overflow = open ? "hidden" : "";
        
        // Gestion du focus pour l'accessibilité
        if (open) {
          elements.closeBtn && elements.closeBtn.focus();
        } else {
          elements.openBtn && elements.openBtn.focus();
        }
      }

      // Écouteurs d'événements
      elements.openBtn && elements.openBtn.addEventListener("click", () => toggleSidebar(true));
      elements.closeBtn && elements.closeBtn.addEventListener("click", () => toggleSidebar(false));
      
      // Fermeture par clic sur l'overlay
      elements.overlay && elements.overlay.addEventListener("click", (event) => {
        if (event.target === elements.overlay) {
          toggleSidebar(false);
        }
      });
      
      // Fermeture par la touche ESC
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && elements.overlay && elements.overlay.classList.contains("open")) {
          toggleSidebar(false);
        }
      });
    </script>

    <script>
      // ============================================
      // CART MANAGEMENT SYSTEM - Functions modulaires
      // ============================================

      const BASE_URL = 'http://localhost:3333';
      const API_URL = `${BASE_URL}/api/cart`;

      // Configure axios to always send cookies with requests (needed for session persistence)
      axios.defaults.withCredentials = true;

      // Éléments DOM réutilisables
      const cart = {
        countElement: document.getElementById('cart-count'),
        itemsElement: document.getElementById('cart-items'),
        emptyElement: document.getElementById('cart-empty'),
        totalPriceElement: document.getElementById('cart-total-price'),
        clearButton: document.getElementById('clear-cart-btn'),
      };

      /**
       * Récupère l'état actuel du panier depuis le serveur
       * GET /api/cart
       * @returns {Promise<{cart: Object, totalItems: number, totalPrice: number}>}
       */
      async function fetchCart() {
        try {
          // GET /api/cart (pas de paramètres)
          const res = await axios.get(`${API_URL}/getCart`);
          const data = res.data || {};
          return data;
        } catch (err) {
          console.error('Erreur lors de la récupération du panier :', err);
          return { cart: { items: [] }, totalItems: 0, totalPrice: 0 };
        }
      }

      /**
       * Met à jour l'UI du panier (badge, total, liste)
       * @param {Object} cartData - Données du panier retournées par l'API
       */
      function updateCartUI(cartData) {
        const { cart: cartObj = { items: [] }, totalItems = 0, totalPrice = 0 } = cartData;

        if (cart.countElement) cart.countElement.textContent = totalItems;
        if (cart.totalPriceElement) cart.totalPriceElement.textContent = `${totalPrice} FCFA`;

        renderCartItems(cartObj.items || []);
      }

      /**
       * Affiche la liste des articles dans le panier
       * @param {Array} items - Tableau des articles du panier
       */
      function renderCartItems(items) {
        console.log('Affichage des articles du panier :', items);
        if (!cart.itemsElement) return;

        cart.itemsElement.innerHTML = '';

        if (!items || items.length === 0) {
          if (cart.emptyElement) cart.emptyElement.style.display = '';
          return;
        }

        if (cart.emptyElement) cart.emptyElement.style.display = 'none';
        items.forEach(item => {
          const li = document.createElement('li');
          li.className = 'flex items-center justify-between p-2 border-b';
          li.innerHTML = `
            <div class="flex flex-col flex-1">
              <span class="font-semibold">${item.name}</span>
              <span class="text-sm text-gray-500">${item.quantity} × ${item.price} FCFA</span>
            </div>
            <div class="flex items-center space-x-2">
              <button data-remove-id="${item.id}" class="btn btn-xs btn-ghost text-red-500 hover:bg-red-50">Supprimer</button>
            </div>
          `;
          cart.itemsElement.appendChild(li);
          {{-- console.log('Article ajouté à l\'UI du panier :', item) --}}
        });
      }

      /**
       * Ajoute un article au panier
       * POST /api/cart
       * @param {number} articleId - ID de l'article à ajouter
       * @param {number} quantity - Quantité (par défaut 1)
       * @param {HTMLElement} button - (Optionnel) Bouton pour affichage du feedback
       * @returns {Promise<{success: boolean, data?: Object, error?: string}>}
       */
      async function addToCart(articleId, quantity = 1, button = null) {
        if (!articleId) {
          console.error('ID de l\'article manquant');
          return { success: false, error: 'ID manquant' };
        }

        const btn = button;
        if (btn) {
          btn.disabled = true;
          btn.dataset.originalText = btn.dataset.originalText || btn.textContent;
          btn.textContent = 'Ajout...';
        }

        try {

          await axios.get(`${API_URL}/addToCart`, { 
            params: {
              articleId: Number(articleId),
              quantity: Number(quantity) || 1,
            }
          });
          console.log('Article ajouté au panier :', articleId, 'Quantité :', quantity);
          const cartData = await fetchCart();
          updateCartUI(cartData);

          if (btn) {
            btn.textContent = 'Ajouté ✓';
            btn.classList.add('bg-green-500', 'text-white');
          }

          return { success: true, data: cartData };
        } catch (err) {
          console.error('Erreur lors de l\'ajout au panier :', err);

          if (btn) {
            btn.textContent = 'Erreur';
            btn.classList.add('bg-red-500', 'text-white');
          }

          return { success: false, error: err.message };
        } finally {
          if (btn) {
            setTimeout(() => {
              btn.disabled = false;
              btn.textContent = btn.dataset.originalText || 'Ajouter au panier';
              btn.classList.remove('bg-green-500', 'text-white', 'bg-red-500');
            }, 1200);
          }
        }
      }

      /**
       * Supprime un article du panier
       * DELETE /api/cart/:id
       * @param {number} articleId - ID de l'article à supprimer
       * @param {boolean} showConfirm - Afficher une confirmation (par défaut false)
       * @returns {Promise<{success: boolean, data?: Object, error?: string, cancelled?: boolean}>}
       */
      async function removeFromCart(articleId, showConfirm = false) {
        if (!articleId) {
          console.error('ID de l\'article manquant');
          return { success: false, error: 'ID manquant' };
        }

        console.log('Tentative de suppression de l\'article ID:', articleId);

        if (showConfirm && !confirm('Êtes-vous sûr de vouloir supprimer cet article ?')) {
          return { success: false, cancelled: true };
        }

        try {
          const deleteUrl = `${API_URL}/${articleId}`;
          console.log('URL de suppression:', deleteUrl);
          await axios.delete(deleteUrl);
          console.log('Article supprimé avec succès');
          const cartData = await fetchCart();
          updateCartUI(cartData);

          console.log('Article supprimé du panier :', articleId);
          return { success: true, data: cartData };
        } catch (err) {
          console.error('Erreur lors de la suppression de l\'article :', err);
          return { success: false, error: err.message };
        }
      }

      /**
       * Vide complètement le panier
       * DELETE /api/cart
       * @param {boolean} showConfirm - Afficher une confirmation (par défaut true)
       * @returns {Promise<{success: boolean, data?: Object, error?: string, cancelled?: boolean}>}
       */
      async function clearCart(showConfirm = true) {
        if (showConfirm && !confirm('Voulez-vous vraiment vider le panier ?')) {
          return { success: false, cancelled: true };
        }

        try {
          // DELETE /api/cart (pas de paramètres)
          await axios.delete(API_URL);
          const cartData = await fetchCart();
          updateCartUI(cartData);

          console.log('Panier vidé');
          return { success: true, data: cartData };
        } catch (err) {
          console.error('Erreur lors du vidage du panier :', err);
          return { success: false, error: err.message };
        }
      }

      /**
       * Modifie la quantité d'un article
       * (Utilise removeFromCart + addToCart jusqu'à une route PUT/PATCH dédiée)
       * @param {number} articleId - ID de l'article
       * @param {number} newQuantity - Nouvelle quantité
       * @returns {Promise<{success: boolean, data?: Object, error?: string}>}
       */
      async function updateQuantity(articleId, newQuantity) {
        if (!articleId || newQuantity < 1) {
          console.error('Paramètres invalides');
          return { success: false, error: 'Paramètres invalides' };
        }

        try {
          await removeFromCart(articleId, false);
          const result = await addToCart(articleId, newQuantity);
          return result;
        } catch (err) {
          console.error('Erreur lors de la mise à jour de la quantité :', err);
          return { success: false, error: err.message };
        }
      }

      // ============================================
      // INITIALISATION & EVENT LISTENERS
      // ============================================

      document.addEventListener('DOMContentLoaded', async () => {
        console.log('🛒 Initialisation du système de panier');

        // Récupération initiale du panier
        const initialData = await fetchCart();
        updateCartUI(initialData);

        // Event listener: Boutons "Ajouter au panier" (via data-article-id)
        document.querySelectorAll('[data-article-id]').forEach(button => {
          button.addEventListener('click', async (event) => {
            const articleId = event.currentTarget.getAttribute('data-article-id');
            if (!articleId) {
              console.error('ID de l\'article non trouvé sur le bouton');
              return;
            }
            await addToCart(articleId, 1, event.currentTarget);
          });
        });

        // Event delegation: Boutons "Supprimer" dans la liste du panier
        if (cart.itemsElement) {
          cart.itemsElement.addEventListener('click', async (event) => {
            console.log('Clic détecté sur l\'élément:', event.target);
            const btn = event.target.closest('[data-remove-id]');
            if (!btn) {
              console.log('Pas de bouton de suppression trouvé');
              return;
            }
            const id = btn.getAttribute('data-remove-id');
            console.log('Suppression de l\'article ID:', id);
            await removeFromCart(id, false);
          });
        }

        // Event listener: Bouton "Vider le panier"
        if (cart.clearButton) {
          cart.clearButton.addEventListener('click', () => clearCart(true));
        }

        // Close mobile menu when clicking a link
        const mobileMenuLinks = document.getElementById('mobile-menu-links');
        if (mobileMenuLinks) {
          const links = mobileMenuLinks.querySelectorAll('a');
          const mobileMenuCheckbox = document.getElementById('mobile-menu-drawer');
          links.forEach(link => {
            link.addEventListener('click', (e) => {
              // Fermer le drawer sans empêcher la navigation
              if (mobileMenuCheckbox) {
                mobileMenuCheckbox.checked = false;
              }
              // Laisser le navigateur suivre le lien naturellement
            });
          });
        }
      });
  </body>
</html>