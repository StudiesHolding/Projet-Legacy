    {{-- 7. IMPORTATIONS GLOBALES/LOGIQUE (À la fin du body) --}}
    {{-- Axios est maintenant déplacé dans app.js ou importé via CDN après le script modale --}}
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script> 
    
    <script>
      // 8. LOGIQUE MODALE (Sidebar)
      
      const selectors = {
        overlay: "#mobile-sidebar-overlay",
        menu: "#mobile-sidebar-menu",
        closeBtn: "#sidebar-close-button",
        // Assurez-vous d'avoir un ID 'burger-button' dans votre header
        openBtn: "#burger-button", 
      };

      const elements = {
        overlay: document.querySelector(selectors.overlay),
        menu: document.querySelector(selectors.menu),
        closeBtn: document.querySelector(selectors.closeBtn),
        openBtn: document.querySelector(selectors.openBtn),
      };

      /**
       * Gère l'état d'ouverture/fermeture du menu mobile.
       * @param {boolean} open - true pour ouvrir, false pour fermer.
       */
      function toggleSidebar(open) {
        if (!elements.overlay || !elements.menu) return;

        elements.overlay.classList.toggle("open", open);
        elements.menu.classList.toggle("open", open);
        
        document.body.style.overflow = open ? "hidden" : "";
        
        // Gestion du focus pour l'accessibilité
        if (open) {
          elements.closeBtn && elements.closeBtn.focus();
        } else {
          elements.openBtn && elements.openBtn.focus();
        }
      }

      // Écouteurs d'événements
      elements.openBtn && elements.openBtn.addEventListener("click", () => toggleSidebar(true));
      elements.closeBtn && elements.closeBtn.addEventListener("click", () => toggleSidebar(false));
      
      // Fermeture par clic sur l'overlay
      elements.overlay && elements.overlay.addEventListener("click", (event) => {
        if (event.target === elements.overlay) {
          toggleSidebar(false);
        }
      });
      
      // Fermeture par la touche ESC
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && elements.overlay && elements.overlay.classList.contains("open")) {
          toggleSidebar(false);
        }
      });
    </script>

