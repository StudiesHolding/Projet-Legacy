      // 9. LOGIQUE D'AJOUT AU PANIER (AXIOS)
      
      document.addEventListener('DOMContentLoaded', () => {
        const cartCountElement = document.getElementById('cart-count'); 
        const cartButtons = document.querySelectorAll('[data-article-id]');
        const apiUrl = 'http://localhost:3333/api/cart';
        cartButtons.forEach(button => {
          button.addEventListener('click', async (event) => {
            const articleId = event.currentTarget.getAttribute('data-article-id');
            console.log(articleId)

            if (!articleId) {
              console.error('ID de l\'article non trouvé sur le bouton.');
              return;
            }

            try {
              // NOTE IMPORTANTE: Votre contrôleur Adonis s'attend à un GET avec paramètres.
              // En production, il est STRONGOEMENT recommandé d'utiliser une méthode POST 
              // pour les actions qui modifient l'état du serveur (comme l'ajout au panier).
              const response = await axios.get(apiUrl, {
                params: { 'articleId': articleId }
              });

              console.log('Ajout réussi:', response.data);
              
              // 10. Mise à jour de l'affichage du panier
              if (cartCountElement && response.data.totalItems !== undefined) {
                cartCountElement.textContent = response.data.totalItems;
              }

            } catch (error) {
              console.error('Erreur lors de l\'ajout au panier:', error);

              // Feedback visuel d'échec
              event.currentTarget.textContent = 'Erreur d\'ajout';
              event.currentTarget.classList.add('bg-red-500', 'text-white', 'border-red-500');

            } 
          });
        });
      });
    </script>
    
