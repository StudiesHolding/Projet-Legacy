<form action="{{ route('handleStepTwoForArticle') }}" method="POST">
    {{ csrfField() }}

    {{-- 1. Technique de fabrication --}}
    <div class="mb-6">
        <label class="block text-gray-700 text-sm font-bold mb-2">
            Technique de fabrication <span class="text-gray-400 font-normal">(Optionnel)</span>
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            @let(labels = ['Tissage', 'Tricot', 'Teinture', 'Broderie', 'Soudure', 'Vannerie', 'Sculpture', 'Forge', 'Poterie'])
            @each(label in labels)
                <label class="inline-flex items-center p-2 border rounded hover:bg-gray-50 cursor-pointer transition">
                    <input type="checkbox" name="craftsmanship[]" value="{{ label }}" class="form-checkbox text-[#171B99]">
                    <span class="ml-2 text-xs text-gray-700">{{ label }}</span>
                </label>
            @end
        </div>
        @if(flashMessages.has('errors.craftsmanship'))
            <p class="text-red-600 text-xs italic mt-2">{{ flashMessages.get('errors.craftsmanship').join(', ') }}</p>
        @end
    </div>

    {{-- 2. Spécificités Décoration & Style --}}
    <div class="mb-6 border-t pt-4">
        <label class="block text-gray-700 text-sm font-bold mb-2">
            Style & Usage <span class="text-gray-400 font-normal">(Pour la décoration)</span>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <span class="text-xs text-gray-500 block mb-1">Style de l'article :</span>
                <select name="style" class="w-full border rounded py-2 px-3 text-sm bg-white focus:ring-1 focus:ring-[#171B99] outline-none">
                    <option value="">-- Non spécifié --</option>
                    <option value="modern">Moderne / Minimaliste</option>
                    <option value="traditional">Traditionnel / Ethnique</option>
                    <option value="vintage">Vintage / Rétro</option>
                    <option value="industrial">Industriel</option>
                </select>
            </div>
            <div>
                <span class="text-xs text-gray-500 block mb-1">Type d'usage :</span>
                <select name="usage" class="w-full border rounded py-2 px-3 text-sm bg-white focus:ring-1 focus:ring-[#171B99] outline-none">
                    <option value="">-- Non spécifié --</option>
                    <option value="indoor">Intérieur uniquement</option>
                    <option value="outdoor">Extérieur (Résistant)</option>
                    <option value="both">Les deux</option>
                </select>
            </div>
        </div>
    </div>

    <div class="mb-6 border-t pt-4">
        <label class="block text-gray-700 text-sm font-bold mb-2">
            Guide des tailles / Dimensions <span class="text-gray-400 font-normal">(Optionnel)</span>
        </label>

        <div class="space-y-4">
            <div>
                <span class="text-xs text-gray-500 block mb-2 underline">Tailles disponibles (Vêtements/Chaussures) :</span>
                <div class="flex flex-wrap gap-2">
                    @let(sizes = ['Unique', 'S', 'M', 'L', 'XL', 'XXL', '38', '40', '42', '44'])
                    @each(size in sizes)
                        <label class="cursor-pointer">
                            <input type="checkbox" name="sizes[]" value="{{ size }}" class="hidden peer">
                            <span class="px-3 py-1 border rounded-md text-sm peer-checked:bg-[#171B99] peer-checked:text-white hover:bg-gray-100 transition">
                                {{ size }}
                            </span>
                        </label>
                    @end
                </div>
            </div>

            <div>
                <span class="text-xs text-gray-500 block mb-2 underline">Mesures de l'objet (cm/g) :</span>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    <input type="number" name="length" placeholder="Long." class="border rounded py-2 px-3 text-sm outline-none">
                    <input type="number" name="width" placeholder="Larg." class="border rounded py-2 px-3 text-sm outline-none">
                    <input type="number" name="height" placeholder="Haut." class="border rounded py-2 px-3 text-sm outline-none">
                    <input type="number" name="weight" placeholder="Poids(g)" class="border rounded py-2 px-3 text-sm outline-none">
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
            <label class="block text-gray-700 text-sm font-bold mb-2">Matériaux <span class="text-xs font-normal text-gray-400">(Bois, Cuir...)</span></label>
            <div id="materials-container" class="space-y-2">
                <input type="text" name="materials[]" class="input w-full border rounded py-2 px-3 text-sm">
            </div>
            <button type="button" id="add-material" class="mt-2 text-xs text-[#171B99] font-bold">+ Ajouter</button>
        </div>

        <div>
            <label class="block text-gray-700 text-sm font-bold mb-2">Variantes <span class="text-xs font-normal text-gray-400">(Couleurs, Motifs...)</span></label>
            <div id="variants-container" class="space-y-2">
                <input type="text" name="variants[]" class="input w-full border rounded py-2 px-3 text-sm">
            </div>
            <button type="button" id="add-variant" class="mt-2 text-xs text-[#171B99] font-bold">+ Ajouter</button>
        </div>
    </div>

    <button type="submit" class="w-full bg-[#171B99] text-white font-bold py-3 rounded-lg hover:bg-blue-800 transition">
        Finaliser mon article
    </button> 
</form>

<script>
    function setupDynamicInputs(buttonId, containerId, inputName) {
        document.getElementById(buttonId).addEventListener('click', () => {
            const container = document.getElementById(containerId);
            const div = document.createElement('div');
            div.className = 'flex gap-2';
            div.innerHTML = `
                <input type="text" name="${inputName}" class="input w-full border rounded py-2 px-3 text-sm" />
                <button type="button" class="text-red-500 remove-input">×</button>
            `;
            container.appendChild(div);
            div.querySelector('.remove-input').addEventListener('click', () => div.remove());
        });
    }
    setupDynamicInputs('add-material', 'materials-container', 'materials[]');
    setupDynamicInputs('add-variant', 'variants-container', 'variants[]');
</script>