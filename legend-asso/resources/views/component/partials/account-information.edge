<div class="bg-white p-6 rounded-xl shadow-md border-t-4 grid-cols-3 border-indigo-500">
    <p class="text-sm font-medium text-gray-500">{{ auth.user.role === 'seller' ? 'Commandes totales' : 'Revenu (Mois)'}}</p>
    <p class="text-3xl font-bold text-gray-900 mt-1">12</p>
    <span class="text-xs text-green-500 font-semibold">+12% vs Mois dernier</span>
</div>

