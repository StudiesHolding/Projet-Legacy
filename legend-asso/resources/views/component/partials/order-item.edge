
<li class="flex justify-between items-center py-3">
    <div>
        <p class="text-sm lg:text-sm lg:font-medium text-gray-700">Commande {{order.id}}</p>
        <p class="text-sm text-gray-500"> Commandé {{ order.createdAt.toRelative() }} </p>
    </div>
    @if(order.isFullyReady) 
        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-orange-100 text-orange-800 mr-4">En attente de livraison</span>
    @elseif(order.status === 'pending')
        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-orange-800 mr-4">En préparation</span>
    @elseif(order.status === 'complete')
        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-800 mr-4">Livrée</span>
    @else
        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-gray-100 text-gray-800 mr-4">Annulé</span>
    @end
    <p class="text-sm lg:font-bold text-md ">{{ formatNumber(order.totalPrice)}} XAF</p>
    <a href="{{route('order.show',{id:order.id})}}" class="btn">voir les détails</a>
</li>