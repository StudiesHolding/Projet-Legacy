<div
  class="flex flex-col items-center bg-white p-1 rounded-2xl m-2 mt-2 hover:shadow-lg transition-shadow duration-300 w-80 border border-[#E0E0E0]"
>
  <a href="{{ route(`show.product`,{
    'slug':article.slug
  })}}">
    <div class="p-2.5 h-80 overflow-hidden rounded-xl bg-clip-border">
      <img
        src="{{ article.images[0]?.imageUrl || 'https://placehold.co/600x400?text=No+Image' }}"
        {{-- {{{ await $slots.images()}}} --}}
        alt="card-image"
        class="h-full w-full rounded-xl object-cover"
      />
    </div>
    <div>
      <div class="p-2">
        <p class="text-slate-800 font-medium px-2">
          {{ truncate(article.name, 35) }}
        </p>
         {{-- <p class="text-sm font-medium text-gray-700">{{ truncate(article.name , 15) }}</p> --}}
        <p class="text-cyan-600 font-semibold px-2">
          {{ formatNumber(article.price)}} FCFA
        </p>
      </div>
    </div>
  </a>
  <button
    class="btn justify-center items-center mb-2 w-11/12 border-[#171B99] border text-center text-[#171B99] transition-all hover:bg-[#171B99] hover:text-white"
    type="button"
    id="add-to-cart-{{ article.id }}"
    data-article-id="{{ article.id }}"
  >
  <p>
    Ajouter au panier
  </p>
  </button>
</div>