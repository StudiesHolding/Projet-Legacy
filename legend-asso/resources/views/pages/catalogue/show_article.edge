{{-- @dd(article) --}}
@component('component/layouts/app')
  @slot("title")
    {{ article.name }}
  @end
  @slot('main')
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 ">
      {{-- Section Images --}}
      <div class="m-1">
        <div class="carousel carousel-center flex flex-row overflow-x-auto h-96 rounded-box space-x-4 p-4">
          @each(image in article.images)
            <div class="carousel-item w-96"> 
              <img
                src="{{ image.imageUrl || 'https://placehold.co/600x400?text=No+Image' }}"
                class="rounded-box w-full h-full object-cover" />
            </div>
          @endeach
          
          @if(article.images.length === 0)
            <div class="carousel-item w-full">
              <img src="https://placehold.co/600x400?text=Article+sans+Image" class="rounded-box w-full h-full object-cover" />
            </div>
          @endif
        </div>
      </div>

      {{-- Section Infos Principales --}}
      <div class="px-2 flex flex-col py-2 justify-start">
        <h1 class="text-3xl font-bold mt-2">
          {{ article.name }}
        </h1>
        
        <div class="mt-2">
          @component('component/partials/category', { name: article.category.name })
          @end
        </div>
        
        <div class="text-[#CE0000] text-2xl font-semibold my-4">
          {{ article.price.toLocaleString() }} FCFA
        </div>
        
        <div class="flex items-center space-x-4 mb-6">
          <button data-decrement-id="{{ article.id }}" class="btn btn-sm bg-gray-200">-</button>
          <span data-qty-id="{{ article.id }}" class="text-xl font-medium w-8 text-center">1</span>
          <button data-increment-id="{{ article.id }}" class="btn btn-sm bg-gray-200">+</button>
        </div>

        <button data-article-id="{{ article.id }}" id="add-to-cart-{{ article.id }}" class="btn bg-[#171B99] text-white w-full py-2 hover:bg-[#171B99]/90">
          Ajouter au panier
        </button>

        <p class="mt-5 text-gray-700 leading-relaxed">
          <span class="font-semibold">À Propos :</span><br> {{ article.about }}
        </p>

        {{-- Spécifique Agroalimentaire --}}
    @if(article.agrofood)
      <div class="mt-6 rounded-lg">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Détails sur le produit</h3>
        <ul class="text-sm space-y-1">
          
          {{-- Affichage des certifications (Tableau) --}}
          <li>
            <strong>Disponibilité :</strong>
            {{ article.available ? 'En stock' : 'Indisponible pour le moment' }}
          </li>
          <li>
            <strong>Certification :</strong> <br>
            {{ article.agrofood.certification ? article.agrofood.certification.join(', ') : 'N/A' }}
          </li>

          {{-- Affichage des ingrédients (Tableau) --}}
          <li>
            <strong>Ingrédients :</strong> <br>
            {{ article.agrofood.ingredient_list ? article.agrofood.ingredient_list.join(', ') : 'Non spécifiés' }}
          </li>

          {{-- Conseil de conservation (String) --}}
          <li>
            <strong>Conservation :</strong> <br>
            {{ article.agrofood.conservation_advice || 'N/A' }}
          </li>
          
        </ul>
      </div>
    @endif
        @include('component/partials/delivery-details')
      </div>
    </div>
    
    {{-- Section Vendeur --}}
    <div class="p-4 mt-6 border-t border-gray-200">
      <h3 class="text-xl font-semibold text-gray-800 mb-4">À propos du vendeur</h3>
      
      <div class="inline-flex mt-2 items-center">
        <img src="https://placehold.co/100" alt="Avatar" class="w-12 h-12 rounded-full object-cover" />
        <p class="mx-3 text-[#CE0000] text-lg font-medium">
          {{-- CORRECTION ICI : article.seller est déjà un User grâce à l'héritage --}}
          {{ article.seller?.name ? article.seller.name.toUpperCase() : 'Vendeur Inconnu' }}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8">
        <div>
          <h3 class="text-lg font-semibold text-gray-800">Secteur d'activité</h3>
          <p class="text-gray-600">{{ article.seller?.sector || 'Général' }}</p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-800">Localisation</h3>
          <p class="text-gray-600">{{ article.seller?.location || 'Non renseignée' }}</p>
        </div>
      </div>
    </div>

    {{-- Autres produits --}}
    <div class="p-4 border-t mt-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Autres produits de ce vendeur</h3>
      <div class="flex overflow-x-auto space-x-4 pb-4">
