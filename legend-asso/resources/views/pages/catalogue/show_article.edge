        A propos du vendeur
      </h3>
      <div class="inline-flex mt-5 items-center">
        <img src="https://placehold.co/400" alt="" class="size-1/12 rounded-4xl" />
        <p class="mx-2 text-[#CE0000] text-lg">{{  article.seller.user.name?.toUpperCase() }}</p>
      </div>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const id = '{{ article.id }}';
      const inc = document.querySelector(`[data-increment-id='${id}']`);
      const dec = document.querySelector(`[data-decrement-id='${id}']`);
      const qtyEl = document.querySelector(`[data-qty-id='${id}']`);
      const addBtn = document.getElementById(`add-to-cart-${id}`);

      // Ensure default quantity is 1
      if (qtyEl && (!qtyEl.textContent || Number(qtyEl.textContent) < 1)) {
        qtyEl.textContent = '1';
      }

      if (inc) {
        inc.addEventListener('click', (e) => {
          e.preventDefault();
          let q = Number(qtyEl.textContent || 1) || 1;
          q = q + 1;
          qtyEl.textContent = q;
        });
      }

      if (dec) {
        dec.addEventListener('click', (e) => {
          e.preventDefault();
          let q = Number(qtyEl.textContent || 1) || 1;
          q = Math.max(1, q - 1);
          qtyEl.textContent = q;
        });
      }

      if (addBtn) {
        addBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          const q = Number(qtyEl.textContent || 1) || 1;
          // Use global addToCart function defined in layout
          if (typeof addToCart === 'function') {
            await addToCart(Number(id), q, addBtn);
          } else {
            // Fallback: call API directly
            try {
              await axios.get(`/api/cart/addToCart`, { params: { articleId: Number(id), quantity: q }, withCredentials: true });
              // Refresh UI if fetchCart exists
              if (typeof fetchCart === 'function' && typeof updateCartUI === 'function') {
                const cartData = await fetchCart();
                updateCartUI(cartData);
              }
            } catch (err) {
              console.error('Erreur ajout au panier (fallback) :', err);
            }
          }
        });
      }
    });
  </script>
      <div>
        <h3 class="text-lg font-semibold text-gray-800 mt-2">
          Categorie
        </h3>
        <p>
          {{article.category}}
        </p>
        <h3 class="text-lg font-semibold text-gray-800 mt-2">
          Localisation
        </h3>
        <p>
          {{article.seller.location}}
        </p>
      </div>
      <div>
        <h3 class="text-large font-semibold text-gray-800 mt-2">
          Autres produits du meme vendeur
        </h3>
        <div class="inline-flex">
          {{-- @each(article.seller.articles, 'component/partials/article-card', article) --}}
        </div>
      </div>
  @endslot
