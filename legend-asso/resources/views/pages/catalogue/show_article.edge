    {{-- Le script reste inchangé et fonctionne correctement --}}
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const id = '{{ article.id }}';
        const inc = document.querySelector(`[data-increment-id='${id}']`);
        const dec = document.querySelector(`[data-decrement-id='${id}']`);
        const qtyEl = document.querySelector(`[data-qty-id='${id}']`);
        const addBtn = document.getElementById(`add-to-cart-${id}`);

        if (qtyEl && (!qtyEl.textContent || Number(qtyEl.textContent) < 1)) {
          qtyEl.textContent = '1';
        }

        if (inc) {
          inc.addEventListener('click', (e) => {
            e.preventDefault();
            let q = Number(qtyEl.textContent || 1) || 1;
            q = q + 1;
            qtyEl.textContent = q;
          });
        }

        if (dec) {
          dec.addEventListener('click', (e) => {
            e.preventDefault();
            let q = Number(qtyEl.textContent || 1) || 1;
            q = Math.max(1, q - 1);
            qtyEl.textContent = q;
          });
        }

        if (addBtn) {
          addBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            const q = Number(qtyEl.textContent || 1) || 1;
            // Utilisez la fonction addToCart globale si elle existe, sinon le fallback
            if (typeof addToCart === 'function') {
              await addToCart(Number(id), q, addBtn);
            } else {
              // Fallback: call API directly (nécessite l'import de axios ou fetch)
              try {
                // Remplacer par l'appel API réel de votre application
                const response = await fetch(`/api/cart/addToCart?articleId=${Number(id)}&quantity=${q}`, {
                    method: 'GET', // ou POST si vous utilisez une méthode plus appropriée
                    credentials: 'include' // si vous utilisez des cookies pour l'auth
                });
                
                if (response.ok) {
                  // Mettre à jour l'interface utilisateur
                  if (typeof fetchCart === 'function' && typeof updateCartUI === 'function') {
                    const cartData = await fetchCart();
                    updateCartUI(cartData);
                  }
                }
              } catch (err) {
                console.error('Erreur ajout au panier (fallback) :', err);
              }
            }
          });
        }
      });
    </script>
  @endslot
