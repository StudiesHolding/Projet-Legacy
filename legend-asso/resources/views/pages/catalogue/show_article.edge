    <style>
      .mySwiper .swiper-slide { opacity: 0.5; transition: 0.3s; height: 90px !important; }
      .mySwiper .swiper-slide-thumb-active { opacity: 1; border-color: #171B99; border-width: 2px; }
      .swiper-button-next:after, .swiper-button-prev:after { font-size: 18px !important; font-weight: bold; }
      .scrollbar-hide::-webkit-scrollbar { display: none; }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
      const swiperThumbs = new Swiper(".mySwiper", {
        direction: "vertical",
        spaceBetween: 10,
        slidesPerView: "auto",
        freeMode: true,
        watchSlidesProgress: true,
      });

      new Swiper(".mySwiper2", {
        spaceBetween: 10,
        navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
        thumbs: { swiper: swiperThumbs },
      });
    </script>
