@component('component/layouts/app')

  @slot('title')
    catalogue
  @end

  @slot('main')
    @include('component/partials/category-section')
    <div class="w-full flex-wrap inline-flex">
      @each(article in articles)
        @component('component/partials/card',{'article':article})
        @end
      @end
    </div>
<div>
  @each(anchor in articles.getUrlsForRange(1, articles.lastPage))
    <a href="{{ anchor.url }}">
      {{ anchor.page }}
    </a>
  @endeach
</div>
    @include('component/partials/pagination')
  @endslot
@end
