        <div>
              <h1 class="text-2xl m-2">Récapitulatif du panier</h1>
          @if(cart.items.length === 0)
            <p class="text-gray-500">Votre panier est vide.</p>
          @else
            <div id="checkout-cart-items">
              @each(item in cart.items)
                <div class="inline-flex items-center mb-4 w-full" data-cart-item-id="{{ item.id }}">
                  <div class="w-1/3">
                    @if(item.image) 
                      <img src="{{ item.image }}" alt="" class="full rounded" />
                    @else
                      <img src="https://placehold.co/400" alt="" class="w-full rounded" />
                    @endif
                  </div>
                  <div class="flex-1 mx-4 py-3 w-full">
                    <p class="text-xs">{{ item.name }}</p>
                    <div class="flex items-center justify-between mt-2">
                      <button data-decrement-id="{{ item.id }}" class="btn">-</button>
                      <span data-qty-id="{{ item.id }}">{{ item.quantity }}</span>
                      <button data-increment-id="{{ item.id }}" class="btn">+</button>
                    </div>
                      <span class="text-sm">Total: <span data-line-total-id="{{ item.id }}">{{ (item.price * item.quantity) }}</span> Fcfa</span>
                  </div>
                </div>
                <div>
              @endeach
            </div>
          @endif
