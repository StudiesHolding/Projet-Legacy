        <div>
              <p>Récapitulatif du panier</p>
          @if(cart.items.length === 0)
            <p class="text-gray-500">Votre panier est vide.</p>
          @else
            <div id="checkout-cart-items">
              @each(item in cart.items)
                <div class="inline-flex items-center mb-4 w-full" data-cart-item-id="{{ item.id }}">
                  <img src="https://placehold.co/400" alt="" class="w-1/4 rounded-lg" />
                  <div class="ml-3 flex-1">
                    <p class="font-semibold">{{ item.name }}</p>
                    <div class="flex items-center justify-around mt-2">
                      <button data-decrement-id="{{ item.id }}" class="btn">-</button>
                      <span data-qty-id="{{ item.id }}">{{ item.quantity }}</span>
                      <button data-increment-id="{{ item.id }}" class="btn">+</button>
                    </div>
                      <span class="text-sm">Total: <span data-line-total-id="{{ item.id }}">{{ item.price * item.quantity }}</span> Fcfa</span>
                  </div>
                </div>
              @endeach
            </div>
          @endif
        </div>

          <div class="w-full justify-center">
        <button class="btn w-full my-3 text-[#171B99]" onclick="my_modal_2.showModal()">Choisir la methode de livraison</button>
        <div class="bg-white rounded-xl shadow-md my-4 p-5">
          <div class="flex justify-between">
            <div>Produits</div>
            <div><span id="checkout-products-total">0 FCFA</span></div>
          </div>
          <div class="flex justify-between">
            <div>Livraison</div>
            <div><span id="checkout-delivery">2 500 FCFA</span></div>
          </div>
          <div class="flex justify-between">
            <div>Total</div>
            <div><span id="checkout-total">0 FCFA</span></div>
          </div>
        </div>
        <div class="my-4 justify-center">
          <form action="">
            <input
              type="text"
              name="reduction-code"
              placeholder="code de reduction"
              id="reduction-code"
              class="border-[#171B99] border rounded-lg my-4 shadow-md h-10 px-2 w-full"
            />
            <button type="button" class="btn p-2 bg-[#171B99] w-full text-white" onclick="checkout()">Effectuer le paiement</button>
          </form>
        </div>
      </div>

  

      <script>
        // Mise à jour de l'UI du checkout à partir du panier serveur
        async function refreshCheckoutUI() {
          try {
            // fetchCart est défini globalement dans le layout
            const data = await fetchCart();
            const cart = (data && data.cart) ? data.cart : { items: [] };
            const totalPrice = data.totalPrice || 0;
            const productsTotalEl = document.getElementById('checkout-products-total');
            const totalEl = document.getElementById('checkout-total');

            if (productsTotalEl) productsTotalEl.textContent = `${totalPrice} FCFA`;
            if (totalEl) {
              // ajouter livraison fixe
              const delivery = 2500;
              totalEl.textContent = `${totalPrice + delivery} FCFA`;
            }

            // Mettre à jour chaque ligne
            cart.items.forEach(item => {
              const container = document.querySelector(`[data-cart-item-id='${item.id}']`);
              if (!container) return;
              const qtyEl = container.querySelector(`[data-qty-id='${item.id}']`);
              const lineTotalEl = container.querySelector(`[data-line-total-id='${item.id}']`);
              if (qtyEl) qtyEl.textContent = item.quantity;
              if (lineTotalEl) lineTotalEl.textContent = (item.quantity * item.price);
            });

            // If an item was removed entirely, remove its element
            const existingEls = document.querySelectorAll('#checkout-cart-items [data-cart-item-id]');
            existingEls.forEach(el => {
              const id = Number(el.getAttribute('data-cart-item-id'));
              if (!cart.items.find(i => i.id === id)) {
                el.remove();
              }
            });
          } catch (err) {
            console.error('Impossible de rafraîchir le checkout UI', err);
          }
        }

        document.addEventListener('DOMContentLoaded', () => {
          const container = document.getElementById('checkout-cart-items');
          if (!container) return;

          container.addEventListener('click', async (event) => {
            const inc = event.target.closest('[data-increment-id]');
            if (inc) {
              const id = inc.getAttribute('data-increment-id');
              await addToCart(Number(id), 1);
              await refreshCheckoutUI();
              return;
            }

            const dec = event.target.closest('[data-decrement-id]');
            if (dec) {
              const id = dec.getAttribute('data-decrement-id');
              await removeFromCart(Number(id), false);
              await refreshCheckoutUI();
              return;
            }
          });

          // initial populate
          refreshCheckoutUI();
        });
      </script>



      <!-- Open the modal using ID.showModal() method -->
<dialog id="my_modal_2" class="modal">
            <div class="modal-box">
          <h3 class="text-lg font-bold">
            Choisir votre Operateur de livraison
