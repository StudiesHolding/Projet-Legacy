      <script>
        async function refreshCheckoutUI() {
          try {
            const data = await fetchCart();
            const cart = (data && data.cart) ? data.cart : { items: [] };
            const totalPrice = Number(data.totalPrice) || 0;
            const productsTotalEl = document.getElementById('checkout-products-total');
            const totalEl = document.getElementById('checkout-total');
            const hiddenInput = document.getElementById('hidden-total-input')

            if (productsTotalEl) productsTotalEl.textContent = `${totalPrice} FCFA`;
            if (totalEl) {
              const delivery = 2500;
              totalEl.textContent = `${totalPrice + delivery} FCFA`;
            }

            if (hiddenInput) {
      hiddenInput.value = finalTotal;
    }

            cart.items.forEach(item => {
              const container = document.querySelector(`[data-cart-item-id='${item.id}']`);
              if (!container) return;
              const qtyEl = container.querySelector(`[data-qty-id='${item.id}']`);
              const lineTotalEl = container.querySelector(`[data-line-total-id='${item.id}']`);
              if (qtyEl) qtyEl.textContent = item.quantity;
              if (lineTotalEl) lineTotalEl.textContent = (item.quantity * item.price);
            });

            const existingEls = document.querySelectorAll('#checkout-cart-items [data-cart-item-id]');
            existingEls.forEach(el => {
              const id = Number(el.getAttribute('data-cart-item-id'));
              if (!cart.items.find(i => i.id === id)) {
                el.remove();
              }
            });
          } catch (err) {
            console.error('Impossible de rafraîchir le checkout UI', err);
          }
        }

        document.addEventListener('DOMContentLoaded', () => {
          const container = document.getElementById('checkout-cart-items');
          if (!container) return;

          container.addEventListener('click', async (event) => {
            const inc = event.target.closest('[data-increment-id]');
            if (inc) {
              const id = inc.getAttribute('data-increment-id');
              await addToCart(Number(id), 1);
              await refreshCheckoutUI();
              return;
            }

            const dec = event.target.closest('[data-decrement-id]');
            if (dec) {
              const id = dec.getAttribute('data-decrement-id');
              await removeFromCart(Number(id), false);
              await refreshCheckoutUI();
              return;
            }
          });

          refreshCheckoutUI();
        });
      </script>

