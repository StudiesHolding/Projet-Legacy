  <dialog id="my_modal_2" class="modal">
    <div class="modal-box">
      <h3 class="text-lg font-bold mb-4">Opérateur de livraison</h3>
      <div class="grid gap-2">
        <label class="flex items-center p-3 border rounded cursor-pointer hover:bg-gray-50">
          <input type="radio" name="transport" value="dhl" class="radio radio-primary mr-4" checked />
          <span>Gozem</span>
        </label>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <script>
    async function refreshCheckoutUI() {
      try {
        const data = await fetchCart();
        const cart = (data && data.cart) ? data.cart : { items: [] };
        const totalPrice = Number(data.totalPrice) || 0;
        const delivery = 2500;
        const finalTotal = totalPrice + delivery;

        // Mise à jour des textes
        document.getElementById('checkout-products-total').textContent = `${totalPrice} FCFA`;
        document.getElementById('checkout-total').textContent = `${finalTotal} FCFA`;
        
        // Mise à jour du champ caché pour le formulaire de transaction
        const hiddenInput = document.getElementById('hidden-total-input');
        if (hiddenInput) hiddenInput.value = finalTotal;

        // Mise à jour des lignes individuelles
        cart.items.forEach(item => {
          const container = document.querySelector(`[data-cart-item-id='${item.id}']`);
          if (container) {
            container.querySelector(`[data-qty-id='${item.id}']`).textContent = item.quantity;
            container.querySelector(`[data-line-total-id='${item.id}']`).textContent = (item.quantity * item.price);
          }
        });

        // Gestion de la suppression visuelle si l'item n'est plus dans le panier
        document.querySelectorAll('[data-cart-item-id]').forEach(el => {
          const id = Number(el.getAttribute('data-cart-item-id'));
          if (!cart.items.find(i => i.id === id)) el.remove();
        });
      } catch (err) {
        console.error('Erreur UI:', err);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('checkout-cart-items-container')?.addEventListener('click', async (e) => {
        const incBtn = e.target.closest('[data-increment-id]');
        const decBtn = e.target.closest('[data-decrement-id]');
        
        if (incBtn) {
          await addToCart(Number(incBtn.dataset.incrementId), 1);
          refreshCheckoutUI();
        } else if (decBtn) {
          await removeFromCart(Number(decBtn.dataset.decrementId), false);
          refreshCheckoutUI();
        }
      });
      refreshCheckoutUI();
    });
  </script>
@end