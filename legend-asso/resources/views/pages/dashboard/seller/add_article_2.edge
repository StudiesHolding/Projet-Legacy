@component('component/layouts/dashboard')
@slot('content')
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('ingredients-container');
        const addButton = document.getElementById('add-ingredient');

        addButton.addEventListener('click', () => {
            const group = document.createElement('div');
            group.className = 'flex gap-2 ingredient-group animate-in fade-in duration-300';

            group.innerHTML = `
                <input
                    type="text"
                    name="ingredient[]"
                    placeholder="Nouvel ingrédient"
                    class="input w-full border rounded py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-[#171B99]"
                />
                <button type="button" class="remove-ingredient text-red-500 hover:text-red-700 px-2">
                    ✕
                </button>
            `;
            container.appendChild(group);
        });

        container.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-ingredient')) {
                e.target.closest('.ingredient-group').remove();
            }
        });
    });
</script>

<div class="bg-white p-6 rounded-xl shadow-md">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">
        Étape 2 : Informations complémentaires
    </h2>
    
    <form action="{{ route('handleStepTwoForArticle') }}" method="POST">
        {{ csrfField() }}

        {{-- Certifications --}}
        <div class="mb-6">
            <label class="block text-gray-700 text-sm font-bold mb-2">
                Certifications / Labels <span class="text-gray-400 font-normal">(Optionnel)</span>
            </label>
            <div class="grid grid-cols-2 gap-2">
                @let(labels = ['Bio', 'Made in cameroon'])
                @each(label in labels)
                    <label class="inline-flex items-center">
                        <input type="checkbox" name="certification[]" value="{{ label }}" class="form-checkbox text-[#171B99]">
                        <span class="ml-2 text-sm text-gray-700">{{ label }}</span>
                    </label>
                @end
            </div>
            @if(flashMessages.has('errors.certification'))
                <p class="text-red-600 text-xs italic mt-2">{{ flashMessages.get('errors.certification').join(', ') }}</p>
            @end
        </div>

        {{-- Ingrédients --}}
        <div class="mb-4">
            <label class="block text-gray-700 text-sm font-bold mb-2">
                Liste d'ingrédients <span class="text-gray-400 font-normal">(Optionnel)</span>
            </label>
            
            <div id="ingredients-container" class="space-y-2 mb-2">
                <div class="flex gap-2 ingredient-group">
                    <input
                        type="text"
                        name="ingredient[]"
                        placeholder="Ex: Sucre"
                        class="input w-full border rounded py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-[#171B99]"
                    />
                </div>
            </div>
            
            @if(flashMessages.has('errors.ingredient'))
                <p class="text-red-600 text-xs italic mb-2">{{ flashMessages.get('errors.ingredient').join(', ') }}</p>
            @end

            <button type="button" id="add-ingredient" class="text-sm flex items-center text-[#171B99] hover:text-blue-800 font-semibold transition">
                <span class="mr-1 text-lg">+</span> Ajouter un ingrédient
            </button>
        </div>

        {{-- Date de péremption --}}
        <div class="mb-4">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="expiry_date">
                À consommer de préférence avant le <span class="text-gray-400 font-normal">(Optionnel)</span>
            </label>
            <input
                type="date"
                id="expiration_date"
                name="expiration_date"
                value="{{ old('expiry_date') || '' }}" 
                class="input w-full border rounded py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-[#171B99]"
            />
            @if(flashMessages.has('errors.expiry_date'))
                <p class="text-red-600 text-xs italic mt-1">{{ flashMessages.get('errors.expiry_date').join(', ') }}</p>
            @end
        </div>

        {{-- Conseil de conservation --}}
        <div class="mb-6">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="conservation_advice">
                Conseils de conservation <span class="text-gray-400 font-normal">(Optionnel)</span>
            </label>
            <textarea
                id="conservation_advice"
                name="conservation_advice"
                placeholder="Comment conserver ce produit ?"
                class="w-full p-4 border border-gray-300 rounded-xl text-gray-800 text-base h-32 focus:ring-2 focus:ring-[#171B99] resize-none transition"
            >{{ old('conservation_advice') ?? '' }}</textarea>
            @if(flashMessages.has('errors.conservation_advice'))
                <p class="text-red-600 text-xs italic mt-1">{{ flashMessages.get('errors.conservation_advice').join(', ') }}</p>
            @end
        </div>

        <div class="flex items-center justify-between gap-4">
            <button type="submit" class="btn flex-1 bg-[#171B99] hover:bg-blue-800 text-white font-bold py-2 px-4 rounded transition">
                Finaliser mon article
            </button>
        </div>  
    </form>
</div>
@endslot
@end