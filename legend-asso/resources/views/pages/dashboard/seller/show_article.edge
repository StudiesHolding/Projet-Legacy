@slot('content')
<div class="bg-white p-6 rounded-xl shadow-md">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Modifier l'article</h2>
    
    <form action="{{ route('article.update', { id: article.id }) }}?_method=PATCH" method="POST" enctype="multipart/form-data">
        {{ csrfField() }}

        {{-- Affichage des images actuelles --}}
        <div class="flex flex-wrap gap-2 mb-4">
            @each(image in article.images)
            <div class="w-24 h-24 border rounded overflow-hidden">
                <img src="{{ image.imageUrl }}" class="object-cover w-full h-full" />
            </div>
            @end
        </div>

        <div class="mb-4">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="images">Remplacer les images (optionnel)</label>
            <input
                type="file"
                id="images"
                name="images[]"
                multiple
                class="input w-full border rounded py-2 px-3 text-gray-700"
            />
            @if(flashMessages.has('errors.images'))
                <p class="text-[#CE0000] text-xs italic mt-1">{{ flashMessages.get('errors.images').join(', ') }}</p>
            @endif
        </div>

        <div class="mb-4">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="name">Nom de l'article</label>
            <input
                required
                type="text"
                id="name"
                name="name"
                value="{{ old('name', article.name) }}"
                class="input w-full border rounded py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            @if(flashMessages.has('errors.name'))
                <p class="text-[#CE0000] text-xs italic mt-1">{{ flashMessages.get('errors.name').join(',') }}</p>
            @endif
        </div>

        <div class="inline-flex justify-between items-center w-full mb-4 p-2 bg-gray-50 rounded">
            <span class="text-gray-700 font-bold text-sm">Disponible</span>
            <label class="toggle text-base-content">
                <input type="checkbox" name="is_available" value="1" {{ article.is_available ? 'checked' : '' }} />
                </label>
        </div>

        <div class="mb-4">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="about">Description</label>
            <textarea
                required
                id="about"
                name="about"
                class="w-full p-4 border border-gray-300 rounded-xl text-gray-800 text-base h-32 focus:ring-2 focus:ring-[#171B99] resize-none"
            >{{ old('about', article.about) }}</textarea>
            @if(flashMessages.has('errors.about'))
                <p class="text-[#CE0000] text-xs italic mt-1">{{ flashMessages.get('errors.about').join(', ') }}</p>
            @endif
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="price">Prix</label>
                <input
                    required
                    type="number"
                    id="price"
                    name="price"
                    value="{{ old('price', article.price) }}" 
                    class="input w-full border rounded py-2 px-3 text-gray-700"
                />
            </div>

            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="measure">Volume/Poids</label>
                <input
                    required
                    type="number"
                    id="measure"
                    name="measure"
                    value="{{ old('measure', article.measure) }}"
                    class="input w-full border rounded py-2 px-3 text-gray-700"
                />
            </div>
        </div>

        <div class="mb-6">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="category">Catégorie</label>
            <select
                id="category"
                name="category"
                class="input w-full border border-gray-300 rounded-lg py-2 px-3 text-gray-700"
                required
            >
                <option value="" disabled>Sélectionnez une catégorie</option>
                {{-- Note: Remplacez 'category_id' par le nom de votre colonne en DB --}}
