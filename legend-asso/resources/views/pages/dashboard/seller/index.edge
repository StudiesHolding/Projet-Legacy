@component('component/layouts/dashboard')
    @slot('content')
    <div class="min-h-screen bg-gray-100">
        <div class="flex flex-col md:flex-row">
            <main class="flex-1 p-4 md:p-8">
                <h1 class="text-3xl font-semibold text-gray-900 mb-6">Résumé des Ventes</h1>
                
                <div class="gap-6 mb-8">
                    @component('component/partials/client-header-info', { orders, totalRevenue, pendingOrders })
                    @end
                </div>

                <div class="bg-white p-6 rounded-xl shadow-md">
                    {{-- CORRECTION : .length et non .lenght --}}
                    @if(pendingOrders.length > 0) 
                        <h2 class="text-xl font-semibold text-gray-800 mb-4">Commandes en attente (À expédier)</h2>
                        
                        <ul class="divide-y divide-gray-200">
                            {{-- On filtre les commandes vraiment en attente --}}
                            @each(order in pendingOrders.filter(o => o.status === 'pending'))
                                <li class="flex justify-between items-center py-4">
                                    <div class="flex-1 min-w-0">
                                        <p class="font-bold text-gray-800 text-lg">Commande #{{ order.id }}</p>
                                        
                                        {{-- Affichage des noms des produits --}}
                                        <div class="text-sm text-gray-600 italic">
                                            @if(order.order_item)
                                                @each(item in order.order_item)
                                                    <span>{{ item.name }} (x{{ item.quantity }}){{ !loop.last ? ', ' : '' }}</span>
                                                @end
                                            @else
                                                <span class="text-gray-400">Détails indisponibles</span>
                                            @end
                                        </div>
                                    </div>
                                    
                                    <div class="flex items-center">
                                        @if(order.status === 'pending') 
                                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-yellow-100 text-yellow-800 mr-4 uppercase tracking-wider">En préparation</span>
                                        @elseif(order.status === 'complete')
                                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-green-100 text-green-800 mr-4 uppercase tracking-wider">Prête</span>
                                        @else
                                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-gray-100 text-gray-800 mr-4 uppercase tracking-wider">{{ order.status }}</span>
                                        @end
                                        
                                        <a href="{{ route('order.showOrderInfo', { id: order.id }) }}" class="bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white px-4 py-2 rounded-lg transition-all text-sm font-semibold">
