@component('component/layouts/dashboard')

    @slot('content')
        @flashMessage('notification')
            <div class="toast toast-end">
                <div class="alert alert-success">
                    <span class="text-white">Votre article a été ajouté</span>
                </div>
            </div>
        @end

        <div class="bg-white p-6 rounded-xl shadow-md">
            <div class="flex items-center justify-between py-3 w-full ">
                <h2 class="text-lg font-semibold text-gray-800">Mes articles</h2>
                <a href="{{route('article.create')}}" class="btn bg-red-500 text-white" >Ajouter</a>
            </div>
            
            @each(article in myArticles)
            <ul class="divide-y divide-gray-200">
                <a href="{{route('article.show',{id:article.id})}}">

                <li class="flex justify-between items-center py-3">
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-700">{{ truncate(article.name , 15) }}</p>
                        <p class="text-sm text-gray-500 truncate">{{ formatNumber(article.price) }} FCFA</p>
                    </div>
                    @if(article.status === 'pending') 
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800 mr-4">En attente</span>
                    @elseif(article.status === 'accepted')
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-800 mr-4">accepté</span>
                    @else
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-gray-100 text-gray-800 mr-4">refusé</span>
                    @end
                </li>    
                </a>
            </ul>
            @end
        </div>
    <div>
        @component('component/partials/pagination', { 'pagination': pagination })
        @endcomponent
</div>
    @end
