        {{-- MODALE CODE PROMO --}}
<dialog id="promo_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box bg-white rounded-2xl p-0 overflow-hidden border-none shadow-2xl max-w-lg">
        {{-- Header --}}
        <div class="p-6 bg-[#171B99] text-white">
            <h3 class="font-bold text-lg flex items-center gap-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
                Appliquer une promotion
            </h3>
            <p class="text-blue-100 text-xs mt-1" id="modal_product_name"></p>
            <input type="hidden" id="modal_product_price_raw">
        </div>

        <form method="POST" action="/seller/promo" class="p-6 space-y-5">
            <input type="hidden" name="article_id" id="modal_article_id">
            
            <div class="grid grid-cols-2 gap-4">
                {{-- Code Promo --}}
                <div class="col-span-1">
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2 tracking-tight">Code Promo</label>
                    <input type="text" name="code" placeholder="EX: VENTE20" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#171B99] outline-none font-mono uppercase">
                </div>
                {{-- Date Expiration --}}
                <div class="col-span-1">
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2 tracking-tight">Date Limite</label>
                    <input type="date" name="expires_at" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#171B99] outline-none text-sm">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                {{-- Type --}}
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2 tracking-tight">Type de remise</label>
                    <select id="promo_type" name="type" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#171B99] outline-none cursor-pointer text-sm">
                        <option value="percentage">Pourcentage (%)</option>
                        <option value="fixed">Somme fixe (FCFA)</option>
                    </select>
                </div>
                {{-- Valeur --}}
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2 tracking-tight">Valeur</label>
                    <div class="relative">
                        <input type="number" id="promo_value" name="value" placeholder="0" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#171B99] outline-none">
                        <span id="value_unit" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-xs">%</span>
                    </div>
                </div>
            </div>

            {{-- Limite d'usage --}}
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase mb-2 tracking-tight">Limite d'utilisation (nombre de clients)</label>
                <input type="number" name="limit" placeholder="Ex: 100 (Laissez vide pour illimité)" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#171B99] outline-none">
            </div>

            {{-- Recapitulatif Impact Prix --}}
            <div class="bg-gray-50 rounded-2xl p-4 border border-dashed border-gray-200">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">Prix après promo</span>
                    <span id="price_preview" class="text-xl font-black text-[#171B99]">--- FCFA</span>
                </div>
            </div>

            {{-- Zone de validation tout en bas --}}
            <div class="pt-4 flex flex-col gap-3">
                <button type="submit" class="w-full py-4 bg-[#171B99] text-white font-black rounded-xl hover:bg-blue-900 transition-all shadow-lg shadow-blue-100 flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Valider la promotion
                </button>
                <button type="button" onclick="promo_modal.close()" class="w-full py-3 text-gray-400 text-sm font-semibold hover:text-gray-600 transition-colors">
                    Annuler et fermer
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop bg-black/40 backdrop-blur-sm"><button>fermer</button></form>
</dialog>

        <script>
            const promoType = document.getElementById('promo_type');
            const promoValue = document.getElementById('promo_value');
            const valueUnit = document.getElementById('value_unit');
            const pricePreview = document.getElementById('price_preview');
            const rawPriceInput = document.getElementById('modal_product_price_raw');

            function updatePricePreview() {
                const originalPrice = parseFloat(rawPriceInput.value) || 0;
                const val = parseFloat(promoValue.value) || 0;
                const type = promoType.value;
                let finalPrice = originalPrice;

                if (type === 'percentage') {
                    valueUnit.textContent = '%';
                    finalPrice = originalPrice - (originalPrice * (val / 100));
                } else {
                    valueUnit.textContent = 'FCFA';
                    finalPrice = originalPrice - val;
                }

                finalPrice = Math.max(0, finalPrice);
                pricePreview.textContent = new Intl.NumberFormat().format(Math.round(finalPrice)) + " FCFA";
            }

            promoType.addEventListener('change', updatePricePreview);
            promoValue.addEventListener('input', updatePricePreview);

            function openPromoModal(id, name, price) {
                document.getElementById('modal_article_id').value = id;
                document.getElementById('modal_product_name').textContent = "Article : " + name;
                rawPriceInput.value = price;
                promoValue.value = ""; // Reset
                updatePricePreview();
                promo_modal.showModal();
            }
        </script>
    @end
@end