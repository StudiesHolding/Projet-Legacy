@component('component/layouts/dashboard')
    @slot('content')
    <div class="min-h-screen bg-gray-100">
        <div class="flex flex-col md:flex-row">
            <main class="flex-1 p-4 md:p-8">
                <h1 class="text-3xl font-semibold text-gray-900 mb-6">Résumé des Ventes</h1>
                
                <div class="gap-6 mb-8">
                    @component('component/partials/client-header-info', { orders, totalRevenue, pendingOrders })
                    @end
                </div>

                <div class="bg-white p-6 rounded-xl shadow-md">
                    @if(pendingOrders.length > 0) 
                        <h2 class="text-xl font-semibold text-gray-800 mb-4">Commandes à traiter</h2>
                        <ul class="divide-y divide-gray-200">
                            @each(order in pendingOrders)
                                <li class="flex justify-between items-center py-4">
                                    <div>
                                        <p class="font-bold text-gray-700">Commande #{{ order.id }}</p>
                                        <p class="text-sm text-gray-500">
                                            {{ formatNumber(Number(order.totalPrice)) }} XAF 
                                            • {{ order.createdAt.toRelative() }}
                                        </p>
                                    </div>

                                    <div class="flex items-center">
                                        @if(order.status === 'pending') 
                                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-yellow-100 text-yellow-800 mr-4">EN ATTENTE</span>
                                        @elseif(order.status === 'complete')
                                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-green-100 text-green-800 mr-4">COMPLÉTÉE</span>
                                        @else
                                            <span class="px-3 py-1 text-xs font-bold rounded-full bg-gray-100 text-gray-800 mr-4">{{ order.status }}</span>
                                        @end

                                        <a href="{{ route('order.showOrderInfo', { id: order.id }) }}" class="text-blue-600 hover:underline font-medium text-sm">
                                            Traiter →
                                        </a>
                                    </div>
                                </li>
                            @end
                        </ul>
                    @else
                        <div class="text-center py-10">
                            <p class="text-gray-500 italic">Aucune commande en attente. 🎉</p>
                        </div>
                    @end

                    @if(pendingOrders.length > 5) 
                        <div class="mt-6">
                            @component('component/partials/pagination', { pagination: pagination })
                            @end
                        </div>
                    @end
                </div>
            </main>
        </div>
    </div>
    @endslot
@end