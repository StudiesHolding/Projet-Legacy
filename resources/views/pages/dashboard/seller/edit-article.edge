                    <select id="category" name="category_id" required class="select select-bordered w-full focus:ring-2 focus:ring-[#171B99]">
                        @each(category in categories)
                            <option value="{{ category.id }}" {{ (old('category_id') || article.categoryId) == category.id ? 'selected' : '' }}>
                                {{ category.name }}
                            </option>
                        @end
                    </select>
                    @if(flashMessages.has('errors.category_id'))
                        <span class="text-error text-xs mt-1">{{ flashMessages.get('errors.category_id') }}</span>
