                <div class="form-control">
                    <label class="label font-bold text-gray-700">Unité de vente</label>
                    <select name="unit_type" class="select select-bordered w-full">
                        @let(currentUnit = old('unit_type') || article.unit_type)
                        <option value="UNIT" {{ currentUnit == 'UNIT' ? 'selected' : '' }}>Pièce (Unit)</option>
                        <option value="KG" {{ currentUnit == 'KG' ? 'selected' : '' }}>Kilogramme (Kg)</option>
                        <option value="L" {{ currentUnit == 'L' ? 'selected' : '' }}>Litre (L)</option>
