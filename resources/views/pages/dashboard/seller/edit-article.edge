                        <span class="text-sm {{ (old('available') ?? article.available) ? 'text-green-600' : 'text-gray-400' }}">
                            {{ (old('available') ?? article.available) ? 'En stock' : 'Indisponible' }}
                        </span>
                        
                        {{-- Logique Toggle corrigée --}}
                        {{-- <input type="hidden" name="available" value="false"> --}}
                        <input 
                            type="checkbox" 
                            name="available" 
                            value="true" 
                            class="toggle toggle-primary"
                            {{ (old('available') ?? article.available) ? 'checked' : '' }} 
                        />
                    </div>
                </div>
            </div>

            {{-- Images --}}
            <div class="form-control bg-gray-50 p-4 rounded-xl border border-dashed border-gray-300">
                <label class="label font-bold text-gray-700">Gestion des visuels</label>
                
                <div class="flex flex-wrap gap-3 mb-4">
                    @each(image in article.images)
                        <div class="relative group w-20 h-20 shadow-sm border rounded-lg overflow-hidden">
