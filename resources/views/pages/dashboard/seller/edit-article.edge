                <div class="form-control">
                    <label class="label font-bold text-gray-700" for="about">Description détaillée</label>
                    <textarea id="about" name="about" required class="textarea textarea-bordered w-full h-32 resize-none">{{ old('about') || article.about }}</textarea>
