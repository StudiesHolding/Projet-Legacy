            <div class="space-y-4">
                <div class="form-control">
                    <label class="label font-bold text-gray-700" for="name">Nom de l'article</label>
                    <input type="text" id="name" name="name" value="{{ old('name') || article.name }}" required class="input input-bordered w-full" />
