              @each(error in flashMessages.get('errors.login'))
                <p class="flex items-center font-medium">
                   <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                   {{ error }}
                </p>
              @end
            </div>
          @endif

          {{-- Formulaire --}}
          <form action="{{route("admin.handleLogin")}}" method="POST" class="space-y-5">
            {{ csrfField() }}

            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-1">Email Administrateur</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="admin@legaci.cm"
                value="{{ old('email') || '' }}" 
                class="w-full px-4 py-3 rounded-xl border {{ flashMessages.has('errors.email') ? 'border-red-500' : 'border-gray-300' }} focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all"
              />
              @if(flashMessages.has('errors.email'))
                <p class="text-red-500 text-xs mt-1 font-medium">{{ flashMessages.get('errors.email').join(', ') }}</p>
              @endif
            </div>

            <div>
              <div class="flex justify-between mb-1">
                <label for="password" class="text-sm font-semibold text-gray-700">Mot de passe</label>
                <a href="#" class="text-xs text-indigo-600 hover:underline font-medium">Oublié ?</a>
              </div>
              <input
                type="password"
                id="password"
                name="password"
                placeholder="••••••••"
                class="w-full px-4 py-3 rounded-xl border {{ flashMessages.has('errors.password') ? 'border-red-500' : 'border-gray-300' }} focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all"
              />
              @if(flashMessages.has('errors.password'))
                <p class="text-red-500 text-xs mt-1 font-medium">{{ flashMessages.get('errors.password').join(', ') }}</p>
