        </a>
      </div>

      <div class="w-full max-w-md">
        {{-- En-tête --}}
        <div class="text-center mb-8">
          <h1 class="text-2xl font-bold text-gray-900 mb-2">Créer un compte</h1>
          <p class="text-sm text-gray-600 px-4">
