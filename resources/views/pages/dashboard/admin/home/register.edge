        </div>

        <div class="bg-white shadow-xl rounded-2xl p-8 border border-gray-100">
          
          {{-- Messages d'erreur globaux --}}
          @if(flashMessages.has('errors.register'))
            <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm rounded-r-lg">
              @each(error in flashMessages.get('errors.register'))
                <p class="flex items-center font-medium">
                   <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                   {{ error }}
                </p>
              @end
            </div>
          @endif

          {{-- Formulaire --}}
          <form action="{{route('admin.registerAdmin')}}" method="POST" class="space-y-4">
            {{ csrfField() }}

            <div>
              <label for="username" class="block text-sm font-semibold text-gray-700 mb-1">Nom d'utilisateur</label>
              <input
                type="text"
                id="username"
                name="username"
                placeholder="johndoe237"
                value="{{ old('username') || '' }}" 
                class="w-full px-4 py-3 rounded-xl border {{ flashMessages.has('errors.username') ? 'border-red-500' : 'border-gray-300' }} focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all"
              />
              @if(flashMessages.has('errors.username'))
                <p class="text-red-500 text-xs mt-1 font-medium">{{ flashMessages.get('errors.username').join(', ') }}</p>
              @endif
            </div>

            <input type="hidden" name="email" value="{{email}}">


            {{-- Mot de passe --}}
            <div>
              <label for="password" class="block text-sm font-semibold text-gray-700 mb-1">Mot de passe</label>
              <input
                type="password"
                id="password"
                name="password"
                placeholder="••••••••"
                class="w-full px-4 py-3 rounded-xl border {{ flashMessages.has('errors.password') ? 'border-red-500' : 'border-gray-300' }} focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all"
              />
              @if(flashMessages.has('errors.password'))
                <p class="text-red-500 text-xs mt-1 font-medium">{{ flashMessages.get('errors.password').join(', ') }}</p>
              @endif
            </div>

            {{-- Confirmation Mot de passe --}}
            <div>
              <label for="password_confirmation" class="block text-sm font-semibold text-gray-700 mb-1">Confirmer le mot de passe</label>
              <input
                type="password"
                id="password_confirmation"
                name="password_confirmation"
                placeholder="••••••••"
                class="w-full px-4 py-3 rounded-xl border {{ flashMessages.has('errors.password_confirmation') ? 'border-red-500' : 'border-gray-300' }} focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all"
              />
            </div>

            <button
              type="submit"
              class="w-full bg-[#171B99] hover:bg-blue-800 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-blue-200 transition-all active:scale-[0.98] mt-2"
            >
              Rejoindre les administrateurs
            </button>
          </form>

