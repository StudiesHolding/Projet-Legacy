  @slot('main')
    <div class="min-h-screen flex flex-col justify-center items-center bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
      
      {{-- Logo --}}
      <div class="mb-8 transition-transform hover:scale-105 duration-300">
