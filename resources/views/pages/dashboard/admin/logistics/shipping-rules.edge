@slot('main')
<div class="min-h-screen bg-gray-100 flex flex-col md:flex-row">
    @include('component/partials/aside-navigation-for-admin')

    <main class="flex-1 p-4 md:p-8">
        <div class="max-w-5xl mx-auto">
            {{-- En-tête --}}
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Grille Tarifaire Logistique</h1>
                    <p class="text-sm text-gray-500">Configurez les frais selon la destination et le poids du colis.</p>
                </div>
                
                <button onclick="document.getElementById('add-rule-modal').classList.remove('hidden')" class="flex items-center gap-2 px-5 py-2.5 bg-[#171B99] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition shadow-lg shadow-blue-900/20">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Nouvelle règle
                </button>
            </div>

            {{-- Liste des tarifs groupés par Zone --}}
            <div class="space-y-6">
                @each(zone in shippingZones)
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                        {{-- Header de Zone --}}
                        <div class="p-6 bg-gray-50/50 border-b border-gray-100 flex justify-between items-center">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-white rounded-lg shadow-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    </svg>
                                </div>
                                <h2 class="text-lg font-black text-gray-900">{{ zone.name }}</h2>
                            </div>
                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">{{ zone.rules.length }} Tranches définies</span>
                        </div>

                        {{-- Tableau des tranches pour cette zone --}}
                        <table class="w-full text-left">
                            <thead>
                                <tr class="text-[10px] font-black text-gray-400 uppercase tracking-widest border-b border-gray-50">
                                    <th class="px-6 py-4">Tranche de poids</th>
                                    <th class="px-6 py-4">Tarif appliqué</th>
                                    <th class="px-6 py-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                @each(rule in zone.rules)
                                    <tr class="hover:bg-gray-50/30 transition">
                                        <td class="px-6 py-4 text-sm font-bold text-gray-700">
                                            {{ rule.minWeight }}kg — {{ rule.maxWeight }}kg
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="text-[#171B99] font-black">{{ rule.price.toLocaleString() }} FCFA</span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <form action="{{ route('admin.logistics.delete-rule', { id: rule.id }) }}?_method=DELETE" method="POST" class="inline">
                                                {{ csrfField() }}
                                                <button type="submit" class="p-2 text-gray-300 hover:text-red-500 transition">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                @end
                            </tbody>
                        </table>
                    </div>
                @else
                    <div class="bg-white rounded-3xl p-20 text-center border-2 border-dashed border-gray-200">
                        <p class="text-gray-400 font-medium">Aucune zone de livraison configurée.</p>
                    </div>
                @end
            </div>
        </div>
    </main>
</div>

{{-- Modal d'ajout --}}
<div id="add-rule-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-md p-8 shadow-2xl">
        <h2 class="text-xl font-bold text-gray-900 mb-2">Nouvelle règle tarifaire</h2>
        <p class="text-xs text-gray-500 mb-6">Associez une ville à une tranche de poids précise.</p>

        <form action="#" method="POST" class="space-y-4">
            {{ csrfField() }}
            
            {{-- Sélection de la Localisation --}}
            <div>
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Ville / Zone</label>
                <select name="zoneName" required class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:ring-2 focus:ring-blue-500 outline-none transition appearance-none">
                    <option value="Douala">Douala</option>
                    <option value="Yaoundé">Yaoundé</option>
                    <option value="Bafoussam">Bafoussam</option>
                    <option value="Garoua">Garoua</option>
                    <option value="Autre">Autres</option>
                    <option value="Autre">Vous etes a l'étranger</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Poids Min (kg)</label>
                    <input type="number" step="0.01" name="minWeight" placeholder="0" required class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:ring-2 focus:ring-blue-500 outline-none transition">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Poids Max (kg)</label>
                    <input type="number" step="0.01" name="maxWeight" placeholder="5" required class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:ring-2 focus:ring-blue-500 outline-none transition">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Tarif de livraison (FCFA)</label>
                <input type="number" name="price" placeholder="2000" required class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:ring-2 focus:ring-blue-500 outline-none transition font-bold text-[#171B99]">
            </div>

            <div class="flex gap-3 pt-4">
                <button type="button" onclick="document.getElementById('add-rule-modal').classList.add('hidden')" class="flex-1 py-3 text-sm font-bold text-gray-500 hover:bg-gray-50 rounded-xl transition">Annuler</button>
                <button type="submit" class="flex-1 py-3 bg-[#171B99] text-white text-sm font-bold rounded-xl shadow-lg shadow-blue-900/20 transition">Confirmer</button>
            </div>
        </form>
    </div>
</div>
@endslot
