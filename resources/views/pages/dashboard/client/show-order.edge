<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Détail de la commande #{{ order[0].id }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        @media print { .no-print { display: none; } body { background: white; p: 0; } }
    </style>
</head>
<body class="p-4 md:p-12">

    <div class="max-w-4xl mx-auto">
        
        {{-- Logo & Header (Inspiré du Login) --}}
        <div class="flex flex-col items-center mb-10">
            <div class="transition-transform hover:scale-105 duration-300 mb-6">
                <a href="{{ route('home') }}">
                    <img src="/images/logo-legaci-new.png" alt="Legaci Logo" class="h-16 w-auto object-contain" />
                </a>
            </div>
            <h1 class="text-3xl font-bold text-gray-900">Récapitulatif de commande</h1>
            <p class="text-gray-500 mt-2 italic font-medium">Soutenez l'artisanat <span class="text-green-600 font-semibold">“Made in Cameroon”</span></p>
        </div>

        <div class="bg-white shadow-xl rounded-2xl border border-gray-100 overflow-hidden">
            
            {{-- Statut & ID --}}
            <div class="p-8 border-b border-gray-100 bg-white flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <p class="text-xs uppercase tracking-widest text-gray-400 font-bold mb-1">Numéro de commande</p>
                    <h2 class="text-xl font-bold text-[#171B99]">#{{ order[0].id }}</h2>
                    <p class="text-gray-500">Date : {{ order[0].createdAt.toFormat('dd/MM/yyyy HH:mm') }}</p>
                </div>
                <div>
                    @let(statusColor = order[0].status === 'completed' ? 'bg-green-100 text-green-700' : (order[0].status === 'pending' ? 'bg-blue-100 text-blue-700' : 'bg-red-100 text-red-700'))
                    <span class="px-5 py-2 rounded-full font-bold text-sm uppercase {{ statusColor }}">
                        {{ order[0].status }}
                    </span>
                </div>
            </div>

            <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-8 bg-white">
                {{-- Adresse --}}
                <div class="space-y-3">
                    <h3 class="flex items-center text-[#171B99] text-sm font-bold uppercase tracking-wider">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        Livraison
                    </h3>
                    <div class="text-gray-600 text-sm leading-relaxed">
                        <p class="font-bold text-gray-900 text-base">Medard Bekoung</p>
                        <p>{{ order[0].shippingAdress.adress }}</p>
                        <p class="font-medium text-indigo-600 mt-1">{{ order[0].phoneNumber }}</p>
                    </div>
                </div>
                {{-- Méthode --}}
                <div class="space-y-3">
                    <h3 class="flex items-center text-[#171B99] text-sm font-bold uppercase tracking-wider">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Expédition
                    </h3>
                    <p class="text-gray-600 text-sm">Livraison à Domicile (Cameroun)</p>
                </div>

                {{-- Paiement --}}
                <div class="space-y-3">
                    <h3 class="flex items-center text-[#171B99] text-sm font-bold uppercase tracking-wider">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                        Paiement
                    </h3>
                    <p class="text-gray-600 text-sm font-medium">Orange / MTN Mobile Money</p>
                </div>
            </div>

            {{-- Table Articles --}}
            <div class="p-8 border-t border-gray-50">
                <h3 class="text-lg font-bold text-gray-900 mb-6 italic">Articles de la commande</h3>
                <div class="space-y-4">
                    @each(item in order[0].order_item)
                    <div class="group flex justify-between items-center p-4 rounded-xl hover:bg-slate-50 transition-colors duration-200 border border-transparent hover:border-gray-100">
                        <div class="flex-1">
                            <h4 class="text-gray-800 font-semibold group-hover:text-[#171B99] transition-colors">{{ item.name }}</h4>
                            <div class="flex gap-4 mt-1">
                                <span class="text-xs font-bold px-2 py-0.5 bg-gray-100 text-gray-500 rounded">Qté: {{ item.quantity }}</span>
                                <span class="text-xs text-gray-400 italic">Prix unitaire: {{ formatNumber(item.priceAtPurchase) }} FCFA</span>
                            </div>
                        </div>
                        <div class="text-right ml-4">
                            <span class="text-lg font-bold text-gray-900">{{ formatNumber(Number(item.quantity * item.priceAtPurchase)) }} FCFA</span>
                            <span class="block text-[10px] text-gray-400 uppercase font-bold">Total</span>
                        </div>
                    </div>
                    @end
                </div>
            </div>

            {{-- Footer / Résumé --}}
            <div class="p-8 bg-[#171B99] text-white">
                <div class="max-w-xs ml-auto space-y-3">
                    <div class="flex justify-between text-blue-200 text-sm">
                        <span>Sous-total</span>
                        <span class="font-medium text-white">{{ formatNumber(order[0].totalPrice) }} FCFA</span>
                    </div>
                    <div class="flex justify-between text-blue-200 text-sm">
                        <span>Frais de livraison</span>
                        <span class="font-medium text-white">0</span>
                    </div>
                    <div class="pt-3 border-t border-blue-800 flex justify-between items-end">
                        <span class="text-lg font-bold">Total général</span>
                        <div class="text-right">
                            <span class="text-2xl font-black text-white leading-none">
                                {{ formatNumber(Number(order[0].totalPrice) + 0) }} 
                            </span>
                            <span class="block text-[10px] font-bold text-blue-300">FCFA</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{-- Actions --}}
        <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4 no-print">
            <button onclick="window.print()" class="flex items-center justify-center gap-2 px-6 py-3 bg-white border border-gray-300 rounded-xl text-gray-700 font-bold hover:bg-gray-50 transition-all shadow-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                Imprimer la facture
            </button>
            <a href="{{ route('home') }}" class="flex items-center justify-center px-6 py-3 bg-[#171B99] text-white font-bold rounded-xl shadow-lg shadow-blue-200 hover:bg-blue-800 transition-all">
                Retour à la boutique
            </a>
        </div>
    </div>

</body>
</html>