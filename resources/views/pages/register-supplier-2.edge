    </div>

    <script>
      // Ta logique JS optimisée pour les nouveaux IDs
      document.addEventListener('DOMContentLoaded', () => {
        const memberStatusGroup = document.getElementById('member_status_group');
        const memberCodeInput = document.getElementById('member_code');
        const submitButton = document.getElementById('submit_button');
        
        function updateFormState(isMember) {
          if (isMember) {
            memberCodeInput.disabled = false;
            memberCodeInput.required = true;
            memberCodeInput.parentElement.style.opacity = '1';
            submitButton.textContent = 'Ajouter mon compte';
          } else {
            memberCodeInput.disabled = true;
            memberCodeInput.required = false; 
            memberCodeInput.value = '';
            memberCodeInput.parentElement.style.opacity = '0.5';
            submitButton.textContent = 'Soumettre aux administrateurs';
          }
        }

        memberStatusGroup.addEventListener('change', (e) => {
          updateFormState(e.target.value === 'true');
        });

        // Init initial
        const checked = document.querySelector('input[name="is_member"]:checked');
        updateFormState(checked && checked.value === 'true');
      });
    </script>
  @endslot
@end