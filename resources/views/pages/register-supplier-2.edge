              placeholder="Entrez votre code de membre"
              {{ old('is_member') !== 'true' ? 'disabled' : '' }}
            />
            @if(flashMessages.has('errors.member_code'))
              <p class="text-red-600 text-xs italic mt-2" role="alert">{{ flashMessages.get('errors.member_code').join(', ') }}</p>
            @end
          </div>

          <div class="flex items-center justify-center">
            <button
              type="submit"
              id="submit_button"
              class="btn w-full max-w-xs bg-[#171B99] transition duration-150 ease-in-out hover:bg-blue-800 text-white font-semibold py-2 px-4 rounded-lg focus:outline-none focus:shadow-outline focus:ring-4 focus:ring-[#171B99]/50"
            >
              {{ old('is_member') === 'true' ? 'Ajouter mon compte' : 'Soumettre aux administrateurs' }}
            </button>
          </div>

        </form>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const memberStatusGroup = document.getElementById('member_status_group');
        const memberCodeInput = document.getElementById('member_code');
        const submitButton = document.getElementById('submit_button');
        
        const labelAddAccount = 'Ajouter mon compte';
        const labelSubmitAdmin = 'Soumettre aux administrateurs';

        /**
         * @param {boolean} isMember - Vrai si "Oui" est sélectionné.
         */
        function updateFormState(isMember) {
          if (isMember) {
            memberCodeInput.disabled = false;
            memberCodeInput.required = true;
            submitButton.textContent = labelAddAccount;
            memberCodeInput.focus();
          } else {
            memberCodeInput.disabled = true;
            memberCodeInput.required = false; 
            memberCodeInput.value = '';
            submitButton.textContent = labelSubmitAdmin;
          }
        }

        const initialMemberStatus = document.querySelector('input[name="is_member"]:checked');
        if (initialMemberStatus) {
            updateFormState(initialMemberStatus.value === 'true');
        } else {
            updateFormState(false);
        }

        memberStatusGroup.addEventListener('change', (event) => {
          if (event.target.name === 'is_member') {
            updateFormState(event.target.value === 'true');
          }
        });
      });
    </script>
  @endslot
@end --}}

