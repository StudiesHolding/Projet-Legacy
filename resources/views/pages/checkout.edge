    <div id="checkout-cart-items-container">
      @if(cart.items.length === 0)
        <p class="text-gray-500">Votre panier est vide.</p>
      @else
        <div id="checkout-cart-items">
          @each(item in cart.items)
            <div class="flex items-center mb-4 bg-white p-3 rounded-lg shadow-sm" data-cart-item-id="{{ item.id }}">
              <div class="w-24">
                <img src="{{ item.image || 'https://placehold.co/400' }}" alt="" class="w-full rounded" />
              </div>
              <div class="flex-1 ml-4">
                <p class="font-medium">{{ item.name }}</p>
                <div class="flex items-center gap-4 mt-2">
                  <button data-decrement-id="{{ item.id }}" class="btn btn-sm btn-outline">-</button>
                  <span data-qty-id="{{ item.id }}" class="font-bold">{{ item.quantity }}</span>
                  <button data-increment-id="{{ item.id }}" class="btn btn-sm btn-outline">+</button>
                </div>
              </div>
              <div class="text-right">
                <span class="block font-bold"><span data-line-total-id="{{ item.id }}">{{ (item.price * item.quantity) }}</span> FCFA</span>
              </div>
            </div>
          @endeach
        </div>
