                  </div>
                  <span class="font-bold text-[#171B99]">2 000 FCFA</span>
                </label>
                
                <label class="flex items-center p-4 border rounded-xl cursor-pointer hover:bg-slate-50 transition-all border-gray-200">
                  <input type="radio" name="shipping" value="express" class="accent-[#171B99] h-4 w-4">
                  <div class="ml-4 flex-1">
                    <span class="block font-bold text-gray-900">Livraison Express</span>
                    <span class="text-sm text-gray-500">Le jour même</span>
                  </div>
                  <span class="font-bold text-gray-900">5 000 FCFA</span>
                </label>
