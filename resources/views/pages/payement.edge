                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
                  </div>
                  <div class="absolute inset-0 border-2 border-transparent peer-checked:border-[#171B99] rounded-xl pointer-events-none"></div>
                </label>
              </div>
            </section>

            <button type="button" onclick="startPaymentCountdown(1)" 
              class="w-full mt-8 bg-[#171B99] hover:bg-[#121570] text-white font-bold py-4 rounded-2xl shadow-lg transition-all transform active:scale-[0.98]">
              Initier le Paiement
            </button>
          </form>
        </div>

        {{-- Colonne de droite : Récapitulatif --}}
        <div class="lg:col-span-1">
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 sticky top-8">
            <h2 class="text-lg font-bold text-gray-800 mb-6">Récapitulatif</h2>
            
            <div class="space-y-4 mb-6">
              @each(item in cart.items)
                <div class="flex justify-between items-center text-sm">
                  <span class="text-gray-600">{{item.name}} ({{item.quantity}})</span>
                  <span class="font-semibold">{{formatNumber(Number(item.price) * Number(item.quantity)) }} FCFA</span>
                </div>
              @end
            </div>

            <div class="py-4 border-t border-b border-dashed border-gray-200 mb-6">
              <label class="block text-xs font-bold text-gray-500 uppercase mb-2 tracking-wider">Code de réduction</label>
              <div class="flex gap-2">
                <input type="text" id="promo-input" placeholder="Ex: LEGACI20" class="flex-1 px-3 py-2 text-sm rounded-lg border border-gray-200 focus:ring-2 focus:ring-[#171B99] outline-none transition-all uppercase">
                <button type="button" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-[#171B99] text-sm font-bold rounded-lg transition-colors">Appliquer</button>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex justify-between text-sm text-gray-500">
                <span>Sous-total</span>
                <span>{{formatNumber(totalPrice)}} FCFA</span>
              </div>
              <div class="flex justify-between text-sm text-gray-500">
                <span>Livraison</span>
                <span>2 000 FCFA</span>
              </div>
              <div class="flex justify-between text-xl font-bold text-gray-900 pt-2 border-t mt-4">
                <span>Total</span>
                <span class="text-[#171B99]">{{formatNumber(totalPrice + 2000)}} FCFA</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {{-- MODALE DE PAIEMENT --}}
    <dialog id="my_modal_5" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box text-center">
        
        {{-- ÉTAT 1 : ATTENTE (CHRONO) --}}
        <div id="modal-content-active">
          <div class="flex justify-center mb-4">
            <span class="loading loading-ring loading-lg text-[#171B99]"></span>
          </div>
          <h3 class="text-xl font-bold text-gray-800">En attente de confirmation</h3>
          <p class="text-xs text-gray-500">Veuillez valider le paiement sur votre téléphone</p>
          
          <div id="timer-display" class="flex justify-center my-6">
            <div class="grid grid-flow-col gap-5 text-center auto-cols-max bg-slate-50 p-4 rounded-2xl">
              <div class="flex flex-col"><span class="countdown font-mono text-3xl text-[#171B99]"><span id="cd-minutes" style="--value:0;"></span></span>min</div>
              <div class="flex flex-col"><span class="countdown font-mono text-3xl text-[#171B99]"><span id="cd-seconds" style="--value:0;"></span></span>sec</div>
            </div>
          </div>
        </div>

        {{-- ÉTAT 2 : EXPIRÉ --}}
        <div id="timeout-message" class="hidden py-6">
          <div class="text-red-500 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0116 0z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-red-600">Session expirée</h3>
          <p class="text-sm text-gray-500 mb-6">Nous n'avons pas reçu de confirmation à temps.</p>
          <button onclick="startPaymentCountdown(1)" class="btn bg-[#171B99] hover:bg-blue-800 text-white w-full max-w-xs">
            Relancer une tentative
          </button>
        </div>

        {{-- ÉTAT 3 : SUCCÈS --}}
        <div id="success-message" class="hidden py-6">
          <div class="text-green-500 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0116 0z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-800">Commande validée !</h3>
          <p class="text-sm text-gray-500 mb-8">Votre paiement a été reçu avec succès.</p>
          <div class="flex flex-col gap-3">
            <a href="{{ route('home') }}" class="btn bg-[#171B99] hover:bg-blue-800 text-white w-full">Continuer mes achats</a>
            <a href="/mon-compte/commandes" class="btn btn-outline border-gray-300 w-full">Voir ma commande</a>
          </div>
        </div>

        {{-- NOUVEL ÉTAT 4 : ERREURS SPÉCIFIQUES (TRADUITES) --}}
        <div id="error-message-block" class="hidden py-6">
          <div class="text-orange-500 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 id="error-title" class="text-lg font-bold text-gray-800">Paiement échoué</h3>
          <p id="error-text" class="text-sm text-gray-500 mb-6"></p>
          <button onclick="document.getElementById('my_modal_5').close()" class="btn btn-outline w-full max-w-xs">
            Réessayer avec un autre numéro
          </button>
        </div>

        <div class="modal-action flex-col gap-3">
          <form method="dialog" class="w-full">
            <button id="btn-close-modal" class="btn btn-ghost btn-sm w-full text-gray-400">Annuler et fermer</button>
          </form>
        </div>
      </div>
    </dialog>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script>
      let paymentInterval;
      let transactionReference = null; 

      // Dictionnaire de traduction des erreurs PawaPay
      const PAWAPAY_MESSAGES = {
        'PAYER_LIMIT_REACHED': "Limite de transaction atteinte. Veuillez utiliser un autre compte.",
        'PAYER_NOT_FOUND': "Le numéro de téléphone n'est pas reconnu par l'opérateur.",
        'PAYMENT_NOT_APPROVED': "Le paiement a été refusé sur le téléphone.",
        'INSUFFICIENT_BALANCE': "Solde insuffisant. Veuillez recharger votre compte.",
        'WALLET_LIMIT_REACHED': "Le portefeuille a atteint sa limite de réception.",
        'UNSPECIFIED_FAILURE': "L'opérateur rencontre un problème technique. Réessayez plus tard.",
        'FAILED': "Le paiement a échoué pour une raison inconnue."
      };

      async function startPaymentCountdown(durationInMinutes) {
        const form = document.getElementById('checkout-form');
        const phoneInput = document.querySelector('input[name="phone"]');
        const modal = document.getElementById('my_modal_5');
        const minDisplay = document.getElementById('cd-minutes');
        const secDisplay = document.getElementById('cd-seconds');
        
        // Eléments de la modale
        const timeoutMessage = document.getElementById('timeout-message');
        const contentActive = document.getElementById('modal-content-active');
        const successMessage = document.getElementById('success-message');
        const errorMessageBlock = document.getElementById('error-message-block');
        const errorText = document.getElementById('error-text');
        const btnClose = document.getElementById('btn-close-modal');

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        modal.showModal();
        clearInterval(paymentInterval);

        // Reset de l'affichage
        successMessage.classList.add('hidden');
        timeoutMessage.classList.add('hidden');
        errorMessageBlock.classList.add('hidden');
        contentActive.classList.remove('hidden');
        if(btnClose) btnClose.classList.remove('hidden');

        try {
          const response = await axios.post("{{ route('transaction.initiate') }}", { 
            number: phoneInput.value
          });

          console.log('Réponse du serveur:', response.data);
          
          transactionReference = response.data.reference || response.data.id;

          if (response.data.status === 'completed') {
            showState('success');
            return;
          }

          console.log('Réponse du serveur:', response.data);

          let time = Math.floor(durationInMinutes * 60);
          paymentInterval = setInterval(async () => {
            time--;
            const minutes = Math.floor(time / 60);
            const seconds = time % 60;

            if (minDisplay) minDisplay.style.setProperty('--value', minutes);
            if (secDisplay) secDisplay.style.setProperty('--value', seconds);

            if (time > 0 && time % 4 === 0 && transactionReference) {
              try {
                const response = await axios.get(`/transaction/status/${transactionReference}`);
                console.log('Vérification du statut:', response.data);
                const status = response.data.status;
                const reason = response.data.reason;
                console.log("Vérification du statut:", status, reason);
                 // Assure-toi que ton contrôleur renvoie le "reason"

                if (status === 'completed' || status === 'success') {
                  showState('success');
                } else if (status === 'failed' || status === 'FAILED') {
                  showState('error', reason);
                }
              } catch (e) { console.log("Vérification..."); }
            }

            if (time <= 0) {
              showState('timeout');
            }
          }, 1000);

        } catch (error) {
          console.error("Erreur:", error);
          modal.close();
          alert("Erreur de connexion au service de paiement.");
        }

        function showState(type, reason = 'FAILED') {
          clearInterval(paymentInterval);
          contentActive.classList.add('hidden');
          
          if (type === 'success') {
            successMessage.classList.remove('hidden');
            if(btnClose) btnClose.classList.add('hidden');
          } else if (type === 'error') {
            errorText.innerText = PAWAPAY_MESSAGES[reason] || PAWAPAY_MESSAGES['FAILED'];
            errorMessageBlock.classList.remove('hidden');
          } else if (type === 'timeout') {
            timeoutMessage.classList.remove('hidden');
          }
        }
      }

      document.getElementById('my_modal_5').addEventListener('close', () => {
        clearInterval(paymentInterval);
      });
    </script>
  @endslot
@end