                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone de contact</label>
                  <input type="tel" name="phone" required placeholder="6xx xx xx xx" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:ring-2 focus:ring-[#171B99] outline-none transition-all">
