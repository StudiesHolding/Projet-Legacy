@component('component/layouts/form')
  @slot('title')
    Vérification OTP
  @end

  @slot('main')
    <div class="min-h-screen flex flex-col justify-center items-center bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
      
      {{-- Logo --}}
      <div class="mb-8 transition-transform hover:scale-105 duration-300">
        <a href="{{ route('home') }}">
          <img src="/images/logo-legaci-new.png" alt="Legaci Logo" class="h-20 w-auto object-contain" />
        </a>
      </div>

      <div class="w-full max-w-md">
        {{-- En-tête --}}
        <div class="text-center mb-8">
          <h1 class="text-2xl font-bold text-gray-900 mb-2">Vérifiez votre identité</h1>
          <p class="text-sm text-gray-600 px-4">
            Entrez le code à 6 chiffres pour sécuriser votre accès.
          </p>
        </div>

        <div class="bg-white shadow-xl rounded-2xl p-8 border border-gray-100">
          
          {{-- Information sur l'email --}}
          @if(session.has('email'))
            <div class="mb-6 p-4 bg-blue-50 border-l-4 border-[#171B99] text-blue-900 text-sm rounded-r-lg flex items-start">
              <span class="mr-3 text-lg">📩</span>
              <p>
                Un code a été envoyé à : <br>
                <span class="font-bold">{{ session.get('email') }}</span>
              </p>
            </div>
          @endif

          {{-- Formulaire OTP --}}
          <form id="otp-form" class="space-y-6">
            {{ csrfField() }}
            
            <div class="flex gap-2 sm:gap-4 justify-center" id="otp-inputs-container">
              @each(i in [1, 2, 3, 4, 5, 6])
                <input
                  type="text"
                  inputmode="numeric"
                  pattern="\d*"
                  maxlength="1"
                  required
                  class="otp-input w-10 h-14 sm:w-12 sm:h-16 text-center text-2xl font-bold text-[#171B99] bg-gray-50 border-2 border-gray-200 rounded-xl focus:border-[#171B99] focus:ring-2 focus:ring-blue-100 outline-none transition-all"
                />
              @end
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-[#171B99] hover:bg-blue-800 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-blue-200 transition-all active:scale-[0.98] flex justify-center items-center"
            >
              Vérifier le code
            </button>
          </form>

          <div class="mt-8 text-center text-sm">
            <p class="text-gray-600 mb-2">Vous n'avez pas reçu le code ?</p>
            <button class="font-bold text-indigo-600 hover:text-indigo-500 transition-colors">
              Renvoyer un nouveau code
            </button>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
      const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
      if (csrfToken) axios.defaults.headers.common['x-csrf-token'] = csrfToken;

      const inputs = document.querySelectorAll('.otp-input');
      const form = document.getElementById('otp-form');
      const btn = document.getElementById('submit-btn');

      // Gestion intelligente du clavier et du focus
      inputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
          if (e.inputType === "insertFromPaste") return; 
          if (e.target.value.length > 1) e.target.value = e.target.value.slice(0, 1);
          if (e.target.value && index < inputs.length - 1) inputs[index + 1].focus();
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !e.target.value && index > 0) {
            inputs[index - 1].focus();
          }
        });

        // Permettre de coller un code entier (ex: 123456)
        input.addEventListener('paste', (e) => {
          const data = e.clipboardData.getData('text').trim();
          if (data.length === 6 && /^\d+$/.test(data)) {
            data.split('').forEach((char, i) => {
              inputs[i].value = char;
            });
            inputs[5].focus();
          }
          e.preventDefault();
        });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = Array.from(inputs).map(i => i.value).join('');
        if (code.length < 6) return;

        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin h-5 w-5 mr-3 text-white" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg> Vérification...`;

        try {
          const response = await axios.post("{{ route('verify-otp') }}", { otp: code });
          if (response.status === 200) {
            window.location.href = response.data.redirectUrl;
          }
        } catch (error) {
          const errorMsg = error.response?.data?.message || "Code incorrect ou expiré.";
          alert(errorMsg);
          inputs.forEach(input => input.value = "");
          inputs[0].focus();
        } finally {
          btn.disabled = false;
          btn.innerText = "Vérifier le code";
        }
      });
    </script>
  @endslot
@end