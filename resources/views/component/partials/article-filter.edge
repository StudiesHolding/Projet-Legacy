<div class="w-full bg-white p-5 mb-8 rounded-2xl border border-gray-100 shadow-sm">
  <form method="GET" action="/" class="flex flex-col lg:flex-row gap-6 lg:items-center">
    
    {{-- Champs cachés --}}
    @if(searchQuery)
      <input type="hidden" name="search" value="{{ searchQuery }}">
    @endif
    @if(categoryName)
      <input type="hidden" name="category" value="{{ categoryName }}">
    @endif

    <div class="flex flex-wrap lg:flex-nowrap gap-4 flex-1">
      
      {{-- Prix Minimum --}}
      <div class="flex-1 min-w-[140px]">
        <label for="price_min" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 ml-1">
          Prix minimum
        </label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">XAF</span>
          <input type="number" name="price_min" id="price_min" value="{{ priceMin }}" placeholder="0" 
            class="w-full pl-12 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#171B99]/20 focus:border-[#171B99] focus:bg-white outline-none transition-all text-sm font-medium text-gray-700">
        </div>
      </div>

      {{-- Prix Maximum --}}
      <div class="flex-1 min-w-[140px]">
        <label for="price_max" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 ml-1">
          Prix maximum
        </label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">XAF</span>
          <input type="number" name="price_max" id="price_max" value="{{ priceMax }}" placeholder="1000" 
            class="w-full pl-12 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#171B99]/20 focus:border-[#171B99] focus:bg-white outline-none transition-all text-sm font-medium text-gray-700">
        </div>
      </div>

      {{-- Disponibilité --}}
      <div class="flex-1 min-w-[180px]">
        <label for="availability" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 ml-1">
          Disponibilité
        </label>
        <div class="relative">
          <select name="availability" id="availability" 
            class="w-full appearance-none px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#171B99]/20 focus:border-[#171B99] focus:bg-white outline-none transition-all text-sm font-medium text-gray-700 cursor-pointer">
            <option value="available" @if(availability === 'available') selected @endif>Disponible uniquement</option>
            <option value="unavailable" @if(availability === 'unavailable') selected @endif>Indisponible</option>
            <option value="all" @if(availability === 'all') selected @endif>Tous les articles</option>
          </select>
          <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>
    </div>

    {{-- Bouton Submit --}}
    <div class="lg:pt-6">
      <button type="submit" class="w-full lg:w-auto flex items-center justify-center gap-2 px-8 py-3 bg-[#171B99] text-white font-bold rounded-xl hover:bg-blue-900 transition-all shadow-lg shadow-blue-100 active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
        Appliquer les filtres
      </button>
    </div>

  </form>
</div>