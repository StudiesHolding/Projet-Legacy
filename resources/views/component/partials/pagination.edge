<nav class="flex items-center justify-center py-10 mb-20 lg:mb-10" aria-label="Pagination">
  <div class="flex items-center space-x-1 sm:space-x-2 bg-white p-2 rounded-2xl shadow-sm border border-gray-100">
    
    {{-- Bouton Précédent --}}
    <a
      href="#"
      class="inline-flex items-center justify-center rounded-xl w-10 h-10 lg:w-auto lg:px-4 lg:h-10 text-sm font-semibold text-gray-500 hover:bg-gray-50 hover:text-[#171B99] transition-all duration-200 ease-in-out disabled:opacity-50 disabled:pointer-events-none"
      aria-label="Page précédente"
    >
      <svg class="h-5 w-5 lg:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span class="hidden lg:inline">Précédent</span>
    </a>

    {{-- Boucle des pages --}}
    <div class="flex items-center">
      @each(anchor in pagination)
        @if(anchor.page === null)
          <span class="px-3 py-2 text-gray-400">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM18 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          </span>
        @else
          <a href="{{ anchor.url }}" 
             class="flex items-center justify-center w-10 h-10 mx-0.5 rounded-xl text-sm font-bold transition-all duration-200
             {{ anchor.isActive ? 
                'bg-[#171B99] text-white shadow-lg shadow-blue-200 scale-110' : 
                'text-gray-600 hover:bg-gray-100 hover:text-gray-900' 
             }}">
            {{ anchor.page }}
          </a>
        @endif
      @endeach
    </div>

    {{-- Bouton Suivant --}}
    <a
      href="#"
      class="inline-flex items-center justify-center rounded-xl w-10 h-10 lg:w-auto lg:px-4 lg:h-10 text-sm font-semibold text-gray-500 hover:bg-gray-50 hover:text-[#171B99] transition-all duration-200 ease-in-out"
      aria-label="Page suivante"
    >
      <span class="hidden lg:inline">Suivant</span>
      <svg class="h-5 w-5 lg:ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</nav>