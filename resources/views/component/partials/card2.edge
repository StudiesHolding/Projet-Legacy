<div class="group bg-white rounded-xl p-3 m-2 border border-gray-100 shadow-sm hover:shadow-md hover:border-[#171B99]/30 transition-all duration-300 w-full max-w-md">
  <a href="{{ route('show.product', { 'slug': article.slug }) }}" class="flex items-center gap-4">
    
    {{-- Miniature de l'image --}}
    <div class="w-16 h-16 flex-shrink-0 bg-gray-50 rounded-lg overflow-hidden border border-gray-50">
        <img 
            src="{{ article.images[0]?.imageUrl || 'https://placehold.co/100x100?text=📦' }}" 
            alt="{{ article.name }}"
            class="w-full h-full object-contain p-1 group-hover:scale-110 transition-transform duration-300"
        />
    </div>

    {{-- Informations --}}
    <div class="flex-1 min-w-0">
        <h4 class="text-sm font-bold text-gray-800 truncate group-hover:text-[#171B99] transition-colors">
          {{ article.name }}
        </h4>
        
        <div class="flex items-center justify-between mt-1">
            <p class="text-[#171B99] text-sm font-extrabold">
              {{ formatNumber(article.price) }} <span class="text-[10px] ml-0.5">FCFA</span>
            </p>
            
            {{-- Petit indicateur fléché qui n'apparaît qu'au survol --}}
            <svg class="w-4 h-4 text-[#171B99] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </div>
    </div>
  </a>
</div>