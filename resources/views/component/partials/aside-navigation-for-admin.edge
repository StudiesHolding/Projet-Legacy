<dialog id="logout_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box p-8 rounded-3xl shadow-2xl border border-gray-50">
        <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-center text-gray-800">Quitter l'administration ?</h3>
        <p class="py-4 text-center text-gray-500">Vous allez être déconnecté de votre espace sécurisé.</p>
        <div class="modal-action flex justify-center gap-3">
            <form method="dialog">
                <button class="px-6 py-2.5 rounded-xl font-semibold text-gray-600 hover:bg-gray-100 transition-all">Annuler</button>
            </form>
            <a href="{{ route('admin.logout') }}" class="px-6 py-2.5 bg-red-500 text-white rounded-xl font-semibold shadow-lg shadow-red-200 hover:bg-red-600 transition-all">Confirmer</a>
        </div>
    </div>
</dialog>