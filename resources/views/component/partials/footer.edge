<footer class="bg-[#171B99] w-full pt-16 pb-24 lg:pb-12 px-6 lg:px-20 mt-20">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      
      {{-- Section : Association --}}
      <div>
        <h2 class="text-white text-xl font-bold mb-6 border-b border-white/20 pb-2 inline-block">
          Association
        </h2>
        <ul class="space-y-3">
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">À propos</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Contact</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Devenir partenaire</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">F.A.Q</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Espace publicitaire</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Plan de site</a></li>
        </ul>
      </div>

      {{-- Section : Entreprise --}}
      <div>
        <h2 class="text-white text-xl font-bold mb-6 border-b border-white/20 pb-2 inline-block">
          Entreprise
        </h2>
        <ul class="space-y-3">
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Partenaires</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Politique de confidentialité</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Mentions légales</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Conditions générales</a></li>
          <li><a href="#" class="text-blue-100 hover:text-white hover:underline transition-colors text-sm">Catalogue produits</a></li>
        </ul>
      </div>

      {{-- Section : Newsletter ou Info (Ajout pour équilibrer le design) --}}
      <div>
        <h2 class="text-white text-xl font-bold mb-6 border-b border-white/20 pb-2 inline-block">
          Newsletter
        </h2>
        <p class="text-blue-100 text-sm mb-4">Restez informé de nos dernières actualités.</p>
        <div class="flex">
          <input type="email" placeholder="Votre email" class="w-full p-2 border border-white/20 rounded-l-lg text-gray-800 outline-none">
          <button class="bg-white text-[#171B99] px-4 rounded-r-lg font-bold hover:bg-blue-50 transition-colors">OK</button>
        </div>
      </div>

      {{-- Section : Nous suivre --}}
      <div>
        <h2 class="text-white text-xl font-bold mb-6 border-b border-white/20 pb-2 inline-block">
          Nous suivre
        </h2>
        <div class="flex gap-4">
          <a href="#" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-white/20 transition-all group">
            <img src="/images/linkedin.png" alt="linkedin" class="w-5 h-5 filter brightness-0 invert" />
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-white/20 transition-all group">
            <img src="/images/tik-tok.png" alt="tik tok" class="w-5 h-5 filter brightness-0 invert" />
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-white/20 transition-all group">
            <img src="/images/social-media.png" alt="x" class="w-5 h-5 filter brightness-0 invert" />
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-white/20 transition-all group">
            <img src="/images/facebook.png" alt="facebook" class="w-5 h-5 filter brightness-0 invert" />
          </a>
        </div>
      </div>

    </div>

    {{-- Copyright --}}
    <div class="mt-16 pt-8 border-t border-white/10 text-center">
      <p class="text-blue-200 text-xs">
        &copy; 2026 Votre Association. Tous droits réservés.
      </p>
    </div>
  </div>
</footer>