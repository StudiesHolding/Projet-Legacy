</div>
@else
<li class="flex flex-col sm:flex-row justify-between items-start sm:items-center py-4 px-4 border-b border-gray-100">
    <div class="flex flex-col gap-1">
        <div class="flex items-center gap-2">
            <span class="text-sm font-bold text-gray-800">Commande #{{ order.id }}</span>
            @let(isReadyForDelivery = order.order_item.every(item => item.status === 'ready-for-delivery'))
            {{-- Badge dynamique --}}
            @if(isReadyForDelivery) 
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                    <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-orange-500"></span> En attente de livraison
                </span>
            @elseif(order.status === 'pending')
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-blue-500"></span> En préparation
                </span>
            @elseif(order.status === 'complete')
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-green-500"></span> Livrée
                </span>
            @else
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                    Annulée
                </span>
            @end
        </div>
        <p class="text-xs text-gray-500">
            Effectuée {{ order.createdAt.toRelative() }}
        </p>
    </div>

    <div class="mt-3 sm:mt-0 flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto">
        <div class="text-right">
            <p class="text-sm font-bold text-gray-900">{{ formatNumber(order.totalPrice) }} XAF</p>
        </div>
        <a href="{{ route('order.show', { id: order.id }) }}" class="text-sm font-semibold text-[#171B99] hover:text-[#171B99] underline-offset-4 hover:underline">
            Détails
        </a>
    </div>
</li>
@end