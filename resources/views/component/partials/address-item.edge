<div class="p-4 bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition-shadow group">
    <div class="flex items-start justify-between mb-3">
        {{-- Badge de type d'adresse (Domicile, Bureau, etc.) --}}
        <div class="flex items-center gap-2">
            <div class="p-2 bg-blue-50 text-[#171B99] rounded-lg group-hover:bg-[#171B99] group-hover:text-white transition-colors">
                @if(address.type === 'home' || !address.type)
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                @else
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                @endif
            </div>
            <span class="text-xs font-bold text-gray-900 uppercase tracking-tight">
                {{ address.type || 'Adresse' }}
            </span>
        </div>

        {{-- Badge "Par défaut" --}}
        @if(address.isDefault)
            <span class="px-2 py-1 bg-green-100 text-green-700 text-[10px] font-black uppercase rounded-md">
                Par défaut
            </span>
        @endif
    </div>

    {{-- Détails de l'adresse --}}
    <div class="space-y-1">
        <p class="text-sm font-bold text-gray-800 leading-tight">
            {{ address.adress }}
        </p>
    </div>

    {{-- Actions rapides (Optionnel) --}}
    <div class="mt-4 pt-3 border-t border-gray-50 flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
        <button class="text-[10px] font-bold text-blue-600 hover:underline">Modifier</button>
        <button class="text-[10px] font-bold text-red-500 hover:underline">Supprimer</button>
    </div>
</div>